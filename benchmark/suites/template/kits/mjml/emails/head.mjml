<!-- Orbit's newsletter kit for MJML, written by Orbit's maintainers: the brand's fonts, palette and styles. Include it in mj-head. -->
<mj-attributes>
  <mj-all font-family="Helvetica, Arial, sans-serif" />
  <mj-section background-color="#ffffff" padding="8px 32px" />
  <mj-column padding="0" />
  <mj-text color="#1f2937" font-size="16px" line-height="24px" padding="0 0 12px 0" />
  <mj-button background-color="#4f46e5" color="#ffffff" font-size="16px" line-height="24px" border-radius="6px" inner-padding="12px 20px" align="left" padding="0 0 16px 0" />
  <mj-image padding="8px 0" />
</mj-attributes>
<mj-style inline="inline">
  .title div { font-size: 20px !important; line-height: 28px !important; }
</mj-style>

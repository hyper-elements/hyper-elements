{
  "name": "@hyper-elements/cli",
  "version": "0.1.0",
  "description": "Preview Hyper Elements templates with no setup: render a .tsx template, take desktop and phone screenshots, and check its design in one command.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyper-elements/hyper-elements.git",
    "directory": "packages/cli"
  },
  "bin": {
    "hyper-elements": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "esbuild": "^0.25.11",
    "playwright-core": "1.60.0"
  },
  "peerDependencies": {
    "@hyper-elements/react": ">=0.3.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@hyper-elements/react": "workspace:^0.3.0",
    "@types/node": "24.9.1",
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.1",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}

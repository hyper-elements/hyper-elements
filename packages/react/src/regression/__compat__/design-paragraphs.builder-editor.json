 "code": "import { Email, Heading, Link, List, ListItem, MergeTag, Span, Text } from \"@hyper-elements/react\";\n\nexport default function Template() {\n  return (\n    <Email previewText=\"Every tool\" style={{ backgroundColor: \"#fafafa\", color: \"#222222\" }}>\n      <Text style={{ fontSize: 14, lineHeight: 1.4, padding: [10, 10, 0, 10] }}>First line</Text>\n      <Text style={{ fontSize: 14, lineHeight: 1.4, textAlign: \"center\", padding: [0, 10, 0, 10] }}><Span style={{ fontWeight: 700 }}>Second</Span>{\" line\"}</Text>\n      <Text style={{ fontSize: 14, lineHeight: 1.4, padding: [0, 10, 0, 10] }}>​</Text>\n      <Text style={{ fontSize: 14, lineHeight: 1.4, padding: [0, 10, 10, 50] }}>Indented</Text>\n      <Text style={{ fontSize: 14, lineHeight: 1.4, padding: [10, 10, 0, 10] }}>One</Text>\n      <Text style={{ fontSize: 14, lineHeight: 1.4, padding: [0, 10, 0, 10] }}>{\" \"}</Text>\n      <Text style={{ fontSize: 14, lineHeight: 1.4, padding: [0, 10, 10, 10] }}>Two</Text>\n      <Text style={{ fontSize: 14, lineHeight: 1.4, padding: 10 }}>{\"Read the \"}<Link href={{ href: \"https://x.test/guide\", target: \"_blank\" }}>guide</Link>{\" or \"}<Link href={{ href: \"https://x.test/faq\", target: \"_self\" }}>FAQ</Link></Text>\n      <Text style={{ fontSize: 14, lineHeight: 1.4, padding: 10 }}>{\"Read \"}<Link href={{ href: \"https://x.test/docs\", target: \"_blank\" }} title=\"Read the docs\" style={{ color: \"#ff0000\" }}>the docs</Link>{\", \"}<Link href={{ href: \"https://x.test/faq\", target: \"_blank\" }}>x.test/faq</Link>{\", \"}<Link href=\"https://x.test/help\" title=\"Help\">x.test/help</Link>{\" or x.test/old\"}</Text>\n      <Text style={{ fontSize: 14, lineHeight: 1.4, padding: [10, 10, 0, 10] }}>{\"Hi \"}<Span style={{ fontWeight: 700 }}><MergeTag name=\"first_name\" /></Span>,</Text>\n      <Heading level={2} style={{ fontSize: 21, lineHeight: \"19.6px\", fontWeight: 700, padding: [17.43, 10, 0, 10] }}>Your order</Heading>\n      <List style={{ fontSize: 14, lineHeight: 1.4, indent: 40, padding: [17.43, 10, 24, 10] }}>\n        <ListItem>Shoes</ListItem>\n        <ListItem>Socks<List style={{ indent: 40 }}><ListItem>Wool</ListItem></List></ListItem>\n      </List>\n    </Email>\n  );\n}\n",

{
  "name": "@hyper-elements/lint",
  "version": "0.1.0",
  "description": "Lint emails and pages for what makes them hard to read: links that don't say where they go, images without alternate text, text that's too small or too faint, headings out of order, merge syntax typed by hand. A Hyper Elements plugin for validate() and render(), in the browser, on a server and in the CLI, and lintHtml() for any HTML email.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyper-elements/hyper-elements.git",
    "directory": "packages/lint"
  },
  "homepage": "https://www.hyperelements.dev/docs/lint",
  "keywords": [
    "email",
    "lint",
    "linter",
    "accessibility",
    "a11y",
    "html-email",
    "contrast",
    "hyper-elements",
    "react",
    "email-testing"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "@hyper-elements/react": ">=0.4.0 <0.5.0"
  },
  "peerDependenciesMeta": {
    "@hyper-elements/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hyper-elements/core": "workspace:*",
    "@hyper-elements/email-clients": "workspace:*",
    "@hyper-elements/react": "workspace:*",
    "@types/node": "24.9.1",
    "@types/react": "^18.3.3",
    "@vitest/coverage-v8": "^3.2.4",
    "playwright": "1.60.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "^8.0.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}

---
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Cmd from "../components/Cmd.astro";
import { site } from "../lib/site";
// Real input and output of `npx @hyper-elements/migrate` (run on the new engine's build, names renamed).
import before from "../generated/migrate/before.tsx?raw";
import after from "../generated/migrate/after.tsx?raw";

const guide = "/docs/migrate/react-email";

// From the agent benchmark (benchmark/README.md, 2026-11-08): Claude Code with Claude Sonnet 5 built the same
// five emails with React Email and with Hyper Elements, 16 runs each, every run held to the same checks.
const bench = "/docs/benchmark";
const wins = [
  { k: "Time to a passing email", v: "2.6× faster", before: 86, after: 33, unit: "s" },
  { k: "Output tokens", v: "3.4× fewer", before: 6215, after: 1831, unit: "" },
  { k: "Turns", v: "Half as many", before: 18, after: 9, unit: "" },
  { k: "Passed the first check", v: "16 of 16", before: 12, after: 16, unit: " of 16" },
];
const n = (x: number, unit: string) => `${x.toLocaleString("en-US")}${unit}`;
const briefs = [
  { t: "Event invite", before: 138, after: 35 },
  { t: "Product launch", before: 109, after: 44 },
  { t: "Order receipt", before: 92, after: 42 },
  { t: "Newsletter", before: 74, after: 32 },
  { t: "Password reset", before: 36, after: 25 },
];
const briefMax = Math.max(...briefs.map((b) => b.before));
const pct = (x: number, max: number) => `width: ${((x / max) * 100).toFixed(1)}%`;

const content = [
  "Every word, in order, with numbers, currency and percentages",
  "Every link, image and alt text, and nothing added",
  "On phones (375px) and wider screens (md:, lg:)",
  "In dark mode, where either side has a dark rule",
  "With each boolean prop flipped",
  "Every block reaching the visual editor",
];
const looks = [
  "Each word's size, weight, italics, case and color",
  "The background behind it, and a link's target",
  "Where each line of text sits across the page",
  "CSS the check doesn't model: white-space, a transform, a text shadow",
];

const options = [
  { flag: "(none)", d: "Converts and checks every template. Writes nothing." },
  { flag: "--write", d: "Replaces each template. Only files git can restore, so git can undo it." },
  { flag: "--out <dir>", d: "Writes the migrated templates to another folder instead." },
  { flag: "--design", d: "Also writes design JSON for Unlayer's visual editor." },
  { flag: "--strict", d: "Fails a template with any difference at all, and doesn't write it." },
  { flag: "--report <file>", d: "Writes the report as JSON or Markdown." },
];

const more = [
  { t: "From Unlayer Elements", d: "A codemod moves templates written with Unlayer Elements to the new components.", code: "--from unlayer-elements", href: "/docs/migrate/unlayer-elements" },
  { t: "Check a hand migration", d: "Compare a template you converted yourself with its original, the same way.", code: "compare <original> <migrated>", href: `${guide}#check-a-template-you-migrated-yourself` },
  { t: "From code", d: "Convert a template from an agent, a build step or a server, and get its HTML and design.", code: "convertReactEmail(Welcome)", href: `${guide}#from-code` },
];
---
<Base title="Migrate from React Email" description="Move React Email templates to Hyper Elements in one command, and your agent writes emails 2.6× faster with 3.4× fewer output tokens. Each template is checked against the original.">
  <section class="m-hero">
    <div class="wrap m-hero-inner">
      <h1 class="h-page"><span class="grad">Migrate from React Email</span></h1>
      <p class="lede">Your agent writes emails 2.6× faster, with 3.4× fewer output tokens. One command moves your templates and checks each one against the original.</p>
      <div class="m-cta">
        <Cmd text={`${site.migrate} src/emails`} />
        <a class="btn btn-ghost" href={guide}>Read the guide <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="section ba-section">
    <div class="wrap">
      <div class="ba reveal">
        <div class="ba-side">
          <p class="ba-label"><span class="ba-name">React Email</span> <a class="ba-stats was" href={bench} title="Median time and output tokens for a coding agent to write a passing email with React Email"><span>{n(wins[0].before, "s")}</span><span>{n(wins[1].before, " tokens")}</span></a></p>
          <CodeBlock code={before.trim()} file="emails/welcome.tsx" />
        </div>
        <div class="ba-side">
          <p class="ba-label"><span class="ba-name">Hyper Elements</span> <a class="ba-stats now" href={bench} title="Median time and output tokens for a coding agent to write a passing email with Hyper Elements"><span>{n(wins[0].after, "s")}</span><span>{n(wins[1].after, " tokens")}</span></a></p>
          <CodeBlock code={after.trim()} file="emails/welcome.tsx" />
        </div>
      </div>
      <div class="term panel reveal">
        <div class="term-bar"><span class="dots"><i></i><i></i><i></i></span>Terminal</div>
        <pre><span class="d">$</span> {site.migrate} emails
<span class="ok">✓</span> emails/welcome.tsx: 100% editable

1 template: 1 migrated and checked. <span class="d">Nothing written: pass --write or --out &lt;dir&gt; to write the migrated templates.</span></pre>
      </div>
    </div>
  </section>

  <section class="section why">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Why migrate</p>
        <h2 class="h-section">Your agent spends less time on every email</h2>
        <p class="sec-sub">We gave Claude Code the same five emails to build with React Email and with Hyper Elements, 16 runs each. A run was done when its email passed the same checks in Chromium, on desktop and on a phone.</p>
      </div>
      <div class="wins">
        {wins.map((w) => {
          const max = Math.max(w.before, w.after);
          return (
            <a class="win reveal" href={bench}>
              <span class="win-k">{w.k}</span>
              <span class="win-v">{w.v}</span>
              <div class="pair">
                <div class="pair-row was">
                  <span class="pair-name">React Email</span>
                  <span class="pair-n">{n(w.before, w.unit)}</span>
                  <span class="bar" aria-hidden="true"><i style={pct(w.before, max)}></i></span>
                </div>
                <div class="pair-row now">
                  <span class="pair-name">Hyper Elements</span>
                  <span class="pair-n">{n(w.after, w.unit)}</span>
                  <span class="bar" aria-hidden="true"><i style={pct(w.after, max)}></i></span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      <div class="briefs reveal">
        <div class="briefs-head">
          <h3>Median seconds to a passing email, per brief</h3>
          <div class="legend" aria-hidden="true">
            <span class="was"><i></i>React Email</span>
            <span class="now"><i></i>Hyper Elements</span>
          </div>
        </div>
        <ul class="brief-rows">
          {briefs.map((b) => (
            <li class="brief">
              <span class="brief-t">{b.t}</span>
              <span class="brief-bars">
                <span class="brief-bar was"><span class="bar" aria-hidden="true"><i style={pct(b.before, briefMax)}></i></span><span class="brief-n"><span class="sr">React Email </span>{b.before}s</span></span>
                <span class="brief-bar now"><span class="bar" aria-hidden="true"><i style={pct(b.after, briefMax)}></i></span><span class="brief-n"><span class="sr">Hyper Elements </span>{b.after}s</span></span>
              </span>
              <span class="brief-x">{(b.before / b.after).toFixed(1)}× faster</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="why-note reveal">Medians, Claude Code 2.1.238 with Claude Sonnet 5, November 8, 2026. Every run reached a passing email. Output tokens are what the agent wrote; the engine writes the tables. MJML and hand-written HTML were measured too. <a href={bench}>The full benchmark →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h-section">What it checks</h2>
        <p class="sec-sub">Both versions are rendered with your PreviewProps and compared. Content that differs fails the run. How it looks is listed for you to fix in the editor.</p>
      </div>
      <div class="checks">
        <article class="tile reveal">
          <div class="tile-head">
            <h3>Content must match</h3>
            <span class="exit err">exit 2</span>
          </div>
          <ul class="ticks">{content.map((c) => <li>{c}</li>)}</ul>
          <p class="tile-note">Anything the converter can't map is kept as HTML that renders as before, so content that differs is a bug.</p>
        </article>
        <article class="tile reveal">
          <div class="tile-head">
            <h3>How it looks is listed</h3>
            <span class="exit ok">exit 0</span>
          </div>
          <ul class="ticks">{looks.map((c) => <li>{c}</li>)}</ul>
          <p class="tile-note">It fails closed: what it can't read on one side is reported with the rule that caused it, not passed.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="opts">
    <div class="wrap opts-head reveal">
      <h2>Options</h2>
      <a href={`${guide}#options`}>All options →</a>
    </div>
    {options.map((o) => (
      <div class="opts-line">
        <div class="wrap opts-row">
          <code>{o.flag}</code>
          <span>{o.d}</span>
        </div>
      </div>
    ))}
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h-section">More ways to migrate</h2>
      </div>
      <div class="more">
        {more.map((m) => (
          <a class="tile more-card reveal" href={m.href}>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
            <pre class="mini">{m.code}</pre>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section final">
    <div class="wrap final-inner reveal">
      <h2 class="h-section">Get started</h2>
      <Cmd text={`${site.migrate} src/emails`} />
      <div class="m-cta">
        <a class="btn btn-primary" href={guide}>Read the guide <span class="arrow">→</span></a>
        <a class="btn btn-ghost" href={site.github}>View on GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .m-hero { padding: clamp(40px, 6vh, 80px) 0 0; }
  .m-hero-inner { display: grid; justify-items: center; text-align: center; gap: 12px; }
  .m-hero .h-page { margin: 0; }
  .m-hero .lede { margin: 0 auto; max-width: 60ch; }
  .m-cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: center; margin-top: 16px; }
  /* The command is one line: it shortens with an ellipsis on a phone instead of widening the page. */
  .m-hero-inner, .final-inner { grid-template-columns: minmax(0, 1fr); }
  .m-cta :global(.cmd), .final-inner :global(.cmd) { max-width: 100%; min-width: 0; }

  /* Why migrate: the agent benchmark, React Email before and Hyper Elements after. */
  .why { padding-top: 0; }
  .eyebrow { margin: 0 0 14px; font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-3); }
  .wins { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .win { display: flex; flex-direction: column; gap: 6px; min-width: 0; padding: 24px; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-1); color: inherit; text-decoration: none; transition: border-color 0.2s; }
  .win:hover, .win:focus-visible { border-color: var(--line-3); }
  .win-k { font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-3); }
  .win-v { font-size: 30px; font-weight: 600; letter-spacing: -0.035em; line-height: 1.1; color: var(--text); margin-top: 4px; }
  .pair { display: grid; gap: 14px; margin-top: 22px; }
  .pair-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; row-gap: 7px; column-gap: 8px; align-items: baseline; }
  .pair-name { font-size: 13px; color: var(--text-2); }
  .pair-n { font: 500 13px var(--mono); color: var(--text); font-variant-numeric: tabular-nums; }
  .was .pair-n { color: var(--text-2); }
  .pair-row .bar { grid-column: 1 / -1; }
  /* Bars: a thin track, the value's end rounded, anchored at the left. */
  .bar { display: block; height: 8px; min-width: 0; }
  .bar i { display: block; height: 100%; border-radius: 0 4px 4px 0; background: var(--text); }
  .was .bar i { background: var(--text-3); opacity: 0.55; }

  .briefs { margin-top: 20px; padding: 28px; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-1); }
  .briefs-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 24px; margin-bottom: 22px; }
  .briefs-head h3 { margin: 0; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; }
  .legend { display: flex; gap: 18px; font-size: 13px; color: var(--text-2); }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .legend i { width: 14px; height: 8px; border-radius: 0 4px 4px 0; background: var(--text); }
  .legend .was i { background: var(--text-3); opacity: 0.55; }
  .brief-rows { list-style: none; margin: 0; padding: 0; display: grid; }
  .brief { display: grid; grid-template-columns: 150px minmax(0, 1fr) 96px; align-items: center; gap: 20px; padding: 14px 0; border-top: 1px solid var(--line); }
  .brief-t { font-size: 15px; color: var(--text); }
  .brief-bars { display: grid; gap: 4px; min-width: 0; }
  .brief-bar { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .brief-bar .bar { flex: 1 1 auto; display: flex; }
  .brief-bar .bar i { flex: none; }
  .brief-n { flex: none; width: 44px; font: 500 12.5px var(--mono); color: var(--text); font-variant-numeric: tabular-nums; }
  .brief-bar.was .brief-n { color: var(--text-3); }
  .brief-x { justify-self: end; font: 500 13px var(--mono); color: var(--text); white-space: nowrap; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .why-note { margin: 20px auto 0; max-width: 760px; text-align: center; font-size: 13.5px; line-height: 1.55; color: var(--text-3); }
  .why-note a { color: var(--text-2); text-decoration: none; white-space: nowrap; }
  .why-note a:hover { color: var(--text); }


  .sec-head { text-align: center; margin: 0 auto 56px; max-width: 680px; }
  .sec-head .h-section { margin: 0; }
  .sec-sub { margin: 12px 0 0; color: var(--text-2); font-size: 17px; line-height: 1.55; }

  /* Before and after, then the run that wrote it, straight under the hero. */
  .ba-section { padding-top: 72px; }
  .ba { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .ba-side { min-width: 0; }
  .ba-side :global(pre) { max-height: 560px; }
  .ba-label { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; margin: 0 0 14px; }
  .ba-name { font-size: 22px; font-weight: 650; letter-spacing: -0.025em; line-height: 1.2; color: var(--text); }
  .ba-stats { display: inline-flex; gap: 6px; text-decoration: none; }
  .ba-stats span { height: 28px; padding: 0 12px; display: inline-grid; place-items: center; border-radius: 999px; font: 600 13.5px var(--mono); font-variant-numeric: tabular-nums; border: 1px solid currentColor; }
  .ba-stats.was { color: var(--err); }
  .ba-stats.now { color: var(--ok); }
  .ba-stats span { background: color-mix(in srgb, currentColor 10%, transparent); border-color: color-mix(in srgb, currentColor 35%, transparent); }
  .term { margin-top: 20px; overflow: hidden; background: #0e0e0e; }
  .term-bar { display: flex; align-items: center; gap: 8px; height: 40px; padding: 0 14px; border-bottom: 1px solid var(--line); background: var(--hover); font: 500 12.5px var(--mono); color: var(--text-3); }
  .term pre { margin: 0; padding: 18px 20px; overflow-x: auto; font: 400 13.5px/1.7 var(--mono); color: var(--text); white-space: pre; }
  .term .d { color: var(--text-3); }
  .term .ok { color: var(--ok); }

  /* Tiles, as on the home page. */
  .tile { position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 14px; padding: 28px; background: var(--bg-1); display: flex; flex-direction: column; gap: 16px; min-width: 0; transition: border-color 0.2s; }
  .tile:hover { border-color: var(--line-3); }
  .tile h3 { margin: 0; font-size: 20px; letter-spacing: -0.025em; font-weight: 650; line-height: 1.2; }
  .tile-note { margin: auto 0 0; font-size: 13.5px; color: var(--text-2); line-height: 1.5; }
  .checks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .tile-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .exit { flex: none; height: 24px; padding: 0 10px; display: inline-grid; place-items: center; border: 1px solid var(--line-2); border-radius: 999px; font: 500 11.5px var(--mono); }
  .exit.err { color: var(--err); }
  .exit.ok { color: var(--ok); }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ticks li { position: relative; padding-left: 24px; color: var(--text); font-size: 15px; line-height: 1.5; }
  .ticks li::before { content: "✓"; position: absolute; left: 0; top: 0; font: 500 13px/1.7 var(--mono); color: var(--text-3); }

  /* Options, as ruled rows like the components page's. */
  .opts { border-bottom: 1px solid var(--line); }
  .opts-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 20px; }
  .opts-head h2 { margin: 0; font-size: 22px; font-weight: 650; letter-spacing: -0.02em; }
  .opts-head a { color: var(--text-2); text-decoration: none; font-size: 14px; font-weight: 500; }
  .opts-head a:hover { color: var(--text); }
  .opts-line { border-top: 1px solid var(--line); }
  .opts-row { display: grid; grid-template-columns: 220px minmax(0, 1fr); align-items: center; gap: 16px; padding-top: 16px; padding-bottom: 16px; }
  .opts-row code { font: 500 13.5px var(--mono); color: var(--text); background: none; border: 0; padding: 0; }
  .opts-row span { color: var(--text-2); font-size: 15px; line-height: 1.5; }

  .more { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .more-card { text-decoration: none; color: inherit; gap: 10px; }
  .more-card h3::after { content: " →"; color: var(--text-3); opacity: 0; transition: opacity 0.15s; }
  .more-card:hover h3::after, .more-card:focus-visible h3::after { opacity: 1; }
  .more-card p { margin: 0; color: var(--text-2); font-size: 15px; line-height: 1.55; }
  .mini { margin: auto 0 0; padding-top: 14px; border-top: 1px solid var(--line); font: 400 12.5px/1.65 var(--mono); color: var(--text); white-space: pre-wrap; overflow-wrap: anywhere; }

  .final { text-align: center; }
  .final-inner { display: grid; justify-items: center; gap: 20px; }
  .final-inner .h-section { margin: 0; }
  .final-inner .m-cta { margin-top: 0; }

  @media (max-width: 1000px) {
    .wins { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sec-head { margin-bottom: 44px; }
    .ba, .checks { grid-template-columns: minmax(0, 1fr); }
    .more { grid-template-columns: minmax(0, 1fr); }
    .opts-row { grid-template-columns: 160px minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .wins { grid-template-columns: minmax(0, 1fr); }
    .win, .briefs { padding: 22px; }
    .brief { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "t x" "b b"; gap: 10px 12px; }
    .brief-t { grid-area: t; }
    .brief-x { grid-area: x; }
    .brief-bars { grid-area: b; }
    .sec-head { margin-bottom: 32px; }
    .tile { padding: 22px; }
    .opts-row { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .m-cta { width: 100%; }
    .m-cta .btn { width: 100%; }
    .term pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  }
</style>

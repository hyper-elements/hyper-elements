---
import AlternativesPage, { type MatrixRow, type Tool } from "../../components/AlternativesPage.astro";
import { site } from "../../lib/site";

// "React Email alternatives": a list page, the format searches for alternatives favor, linking to each comparison
// page. Keep it evergreen: no versions or dates on it. Its facts were last checked on November 14, 2026 against
// react-email 6.11.13, MJML 5.4.1, Maizzle 6.3.2 and jsx-email 3.2.1 (each one's docs and README), and Hyper
// Elements 0.4. React Email's agent skill is resend/react-email (Resend's docs). Maizzle and jsx-email weren't in the
// agent benchmark, so the chart doesn't show them.

const tools: Tool[] = [
  {
    id: "hyper-elements",
    name: "Hyper Elements",
    best: "Best for coding agents, and for emails checked in every client",
    what: "React components your agent writes, rendered to email-safe HTML that works in Outlook, checked and previewed in every email client, and kept on brand with a theme.",
    pick: [
      "You want to see each email in Outlook, Gmail and Apple Mail before you send, with a free emulator",
      "You want problems caught in your tests and CI, each with what to write instead",
      "An agent writes your emails: 2.6× faster than with React Email in our benchmark",
      "One theme should keep every email on brand",
      "You want to move your React Email templates with one checked command",
    ],
    mind: ["Styles are typed objects, not Tailwind classes", "Newer, with a smaller community than React Email"],
    links: [
      { label: "Compare with React Email", href: "/compare/react-email" },
      { label: "Get started", href: "/docs/quickstart" },
    ],
  },
  {
    id: "mjml",
    name: "MJML",
    best: "Best if you don't write emails in React",
    what: "A markup language for responsive email, around since 2015, that compiles to the tables Outlook needs.",
    pick: ["You don't use React or JavaScript templates", "You want markup that's been tested in Outlook for years"],
    mind: ["No variables, loops or conditions: you add a templating language", "Email HTML only, with no plain-text version"],
    links: [
      { label: "Compare with Hyper Elements", href: "/compare/mjml" },
      { label: "mjml.io", href: "https://mjml.io" },
    ],
  },
  {
    id: "maizzle",
    name: "Maizzle",
    best: "Best for teams who know Vue and Tailwind",
    what: "A framework for HTML emails with Vue components and Tailwind CSS, with a dev server that flags CSS email clients don't support.",
    pick: ["Your team writes Vue and Tailwind", "You want unsupported CSS flagged while you work"],
    mind: ["Moving from React Email means rewriting JSX as Vue", "Its checks run in the dev server, not in the build"],
    links: [{ label: "maizzle.com", href: "https://maizzle.com" }],
  },
  {
    id: "jsx-email",
    name: "jsx-email",
    best: "Best for staying on React components",
    what: "React components and helpers for email from an independent maintainer, with a CLI that checks client support.",
    pick: ["You want React components with familiar names (Html, Section, Button)", "You want client support checked from the command line"],
    mind: ["Community-driven, with one maintainer", "Needs React 19.1 and Node.js 22"],
    links: [{ label: "jsx.email", href: "https://jsx.email" }],
  },
];

// The agent benchmark (/docs/benchmark, 2026-11-08): medians of 16 runs each, the same five emails and checks.
const bench = "/docs/benchmark";
const race = [
  { name: "Hyper Elements", s: 33, tokens: 1831, first: "16 of 16", he: true },
  { name: "MJML", s: 43, tokens: 2762, first: "16 of 16" },
  { name: "Hand-written HTML", s: 60, tokens: 4903, first: "6 of 16" },
  { name: "React Email", s: 86, tokens: 6215, first: "12 of 16" },
];
const maxS = Math.max(...race.map((r) => r.s));
const maxT = Math.max(...race.map((r) => r.tokens));
const pct = (n: number, max: number) => `width: ${((n / max) * 100).toFixed(1)}%`;

// Side by side.
const cols = ["Hyper Elements", "React Email", "MJML", "Maizzle", "jsx-email"];
const writtenIn = ["React and TypeScript", "React", "MJML markup", "Vue and Tailwind", "React"];
const matrix: MatrixRow[] = [
  { k: "Email client previews", m: [["yes", "Outlook, Gmail and more"], ["no"], ["no"], ["no"], ["no"]] },
  { k: "Client support checks in CI", m: [["yes"], ["part", "Preview window"], ["no"], ["part", "Dev server"], ["yes", "email check"]] },
  { k: "Accessibility lint", m: [["yes", "18 rules"], ["part", "Alt text"], ["no"], ["part", "Alt text"], ["no"]] },
  { k: "Brand theme with tokens", m: [["yes"], ["part", "Tailwind"], ["part", "mj-attributes"], ["part", "Tailwind"], ["part", "Tailwind"]] },
  { k: "Outlook tables worked out", m: [["yes"], ["part"], ["yes"], ["part", "Outlook helpers"], ["part", "Conditional"]] },
  { k: "Data, loops and conditions", m: [["yes"], ["yes"], ["no", "Add a templating language"], ["yes"], ["yes"]] },
  { k: "Plain-text version", m: [["yes"], ["yes"], ["no"], ["yes"], ["yes"]] },
  { k: "Agent skill", m: [["yes"], ["yes"], ["no"], ["yes"], ["no"]] },
  { k: "Moves React Email templates", m: [["yes", "One command, checked"], ["na"], ["no"], ["part", "Guide"], ["no"]] },
  { k: "Web pages, PDFs and images", m: [["yes", "From one template"], ["no"], ["no"], ["no"], ["no"]] },
  { k: "Open source, MIT", m: [["yes"], ["yes"], ["yes"], ["yes"], ["yes"]] },
];
// Each question here is also the page's FAQPage for search engines, so keep the answers plain text.
const faq = [
  {
    q: "What is the best React Email alternative?",
    a: "It depends on how you work. If you want every email checked and previewed in Outlook, Gmail and Apple Mail before you send, or a coding agent writes your emails, Hyper Elements: it comes with a free email client emulator, and in our benchmark an agent reached a passing email 2.6× faster than with React Email. If you don't use React, MJML. If your team writes Vue and Tailwind, Maizzle. If you want to stay close to React Email's components, jsx-email.",
  },
  {
    q: "Are the React Email alternatives free?",
    a: "Yes. Hyper Elements, MJML, Maizzle and jsx-email are all open source under the MIT license, like React Email. Hyper Elements' email client emulator, which previews Outlook, Gmail, Apple Mail, Yahoo Mail and more, is free too.",
  },
  {
    q: "Can I move my React Email templates automatically?",
    a: "With Hyper Elements, yes: npx @hyper-elements/migrate converts each template and checks it against the original before it writes anything. Maizzle has a guide for rewriting React Email templates as Vue by hand. MJML and jsx-email have no migration tool.",
  },
  {
    q: "Which React Email alternative works best with AI coding agents?",
    a: "In our benchmark, Claude Code built the same five emails with each approach. Its median time to a passing email was 33 seconds with Hyper Elements, 43 with MJML, 60 with hand-written HTML and 86 with React Email. Maizzle and jsx-email weren't measured. Hyper Elements, React Email and Maizzle each publish an agent skill.",
  },
  {
    q: "Which alternatives support Tailwind?",
    a: "Maizzle and jsx-email. Hyper Elements takes typed style objects instead, so a style that doesn't exist is a TypeScript error and validate() says what to write instead. MJML styles each component with its own attributes.",
  },
  {
    q: "Can any of them preview emails in Outlook and Gmail?",
    a: "Hyper Elements comes with an email client emulator that previews classic Outlook, Outlook.com, Gmail, Apple Mail, Yahoo Mail and more on your machine. React Email, Maizzle and jsx-email check CSS support against caniemail's tables but don't preview the email in each client, and MJML does neither. The emulator also takes any HTML email, so you can preview emails built with the others too.",
  },
];

---
<AlternativesPage
  path="/alternatives/react-email"
  image="/img/alternatives/react-email-og.png"
  imageAlt="React Email alternatives: Hyper Elements, MJML, Maizzle and jsx-email. Four ways to build better emails."
  imageWidth={1774}
  imageHeight={887}
  metaTitle="React Email alternatives: 4 options compared"
  description="The best React Email alternatives compared: Hyper Elements, MJML, Maizzle and jsx-email. When to pick each, and how fast a coding agent writes an email with it."
  title="React Email alternatives"
  lede="Four other ways to write emails, what each one is best at, and how fast a coding agent writes an email with it."
  tools={tools}
  feature={{ title: "How fast a coding agent writes an email", sub: "Claude Code built the same five emails with each, 16 runs each. A run was done when its email passed the same checks in Chromium, on desktop and on a phone." }}
  tableTitle="React Email and its alternatives, side by side"
  cols={cols}
  textRows={[{ k: "Write emails in", values: writtenIn }]}
  matrix={matrix}
  faqTitle="Questions about React Email alternatives"
  faq={faq}
  final={{
    title: "Move from React Email in one command",
    sub: "Converts every template, checks each against the original, and writes nothing until you ask.",
    cmd: `${site.migrate} src/emails`,
    ctas: [{ label: "How migrating works", href: "/migrate" }, { label: "Hyper Elements vs React Email", href: "/compare/react-email" }],
    others: [{ label: "Hyper Elements vs MJML", href: "/compare/mjml" }, { label: "Litmus alternatives", href: "/alternatives/litmus" }],
  }}
>
  <a class="board reveal" href={bench} aria-label="Agent benchmark: Hyper Elements, MJML, hand-written HTML and React Email">
    <div class="board-cols">
      <div>
        <p class="board-k">Median time to a passing email</p>
        <ul class="bars">
          {race.map((r) => (
            <li class:list={{ he: r.he }}>
              <span class="bar-name">{r.name}</span>
              <span class="bar"><i style={pct(r.s, maxS)}></i></span>
              <span class="bar-n">{r.s}s</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="board-k">Median output tokens</p>
        <ul class="bars">
          {race.map((r) => (
            <li class:list={{ he: r.he }}>
              <span class="bar-name">{r.name}</span>
              <span class="bar"><i style={pct(r.tokens, maxT)}></i></span>
              <span class="bar-n">{r.tokens.toLocaleString("en-US")}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="board-note">Passed the first check: Hyper Elements and MJML 16 of 16, React Email 12 of 16, hand-written HTML 6 of 16. Maizzle and jsx-email weren't measured. <span class="board-more">The benchmark →</span></p>
  </a>
</AlternativesPage>

<style>
  /* The benchmark: two bar charts. */
  .board { display: block; padding: 32px; border: 1px solid var(--line-2); border-radius: 18px; background: linear-gradient(180deg, var(--bg-2), var(--bg-1)); box-shadow: var(--shadow); color: inherit; text-decoration: none; transition: border-color 0.2s; }
  .board:hover, .board:focus-visible { border-color: var(--line-3); }
  .board-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .board-k { margin: 0 0 18px; font-size: 15px; font-weight: 600; }
  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .bars li { display: grid; grid-template-columns: 140px minmax(0, 1fr) 56px; gap: 12px; align-items: center; }
  .bar-name { font-size: 14px; color: var(--text-2); }
  .bars li.he .bar-name { color: var(--text); font-weight: 600; }
  .bar { display: flex; height: 14px; }
  .bar i { display: block; height: 100%; border-radius: 0 7px 7px 0; background: var(--text-3); opacity: 0.45; }
  .bars li.he .bar i { opacity: 1; background: linear-gradient(90deg, color-mix(in srgb, var(--ok) 55%, transparent), var(--ok)); }
  .bar-n { font: 500 13px var(--mono); font-variant-numeric: tabular-nums; color: var(--text-2); text-align: right; }
  .bars li.he .bar-n { color: var(--text); }
  .board-note { margin: 28px 0 0; padding-top: 18px; border-top: 1px solid var(--line); font-size: 13px; line-height: 1.55; color: var(--text-3); }
  .board-more { color: var(--text-2); white-space: nowrap; }

  @media (max-width: 1000px) {
    .board-cols { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  }
  @media (max-width: 640px) {
    .board { padding: 20px; }
    .bars li { grid-template-columns: 112px minmax(0, 1fr) 46px; gap: 8px; }
    .bar-name { font-size: 13px; }
  }
</style>

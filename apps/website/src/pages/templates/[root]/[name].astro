---
import Base from "../../../layouts/Base.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import Preview from "../../../components/Preview.astro";
import { brandsFor, galleryTemplates, previewWidth, type TemplateInfo } from "../../../lib/gallery";

export function getStaticPaths() {
  return galleryTemplates.map((t) => ({ params: { root: t.folder, name: t.name }, props: { t } }));
}
const { t } = Astro.props as { t: TemplateInfo };
const list = brandsFor(t);
const views = t.root === "Document" ? (["desktop", "pdf"] as const) : t.root === "Canvas" ? (["image"] as const) : t.root === "Email" ? (["desktop", "phone", "text"] as const) : (["desktop", "phone"] as const);
const width = previewWidth(t);
// A PDF is shown at the width its page is drawn: the preview's own width.
const pdfWidth = `--pdf-w:${width}px`;
const file = `${t.name}.tsx`;
// The stage's tabs: an email or page at desktop width and on a phone (an email's plain text too), a document as its
// page and as its PDF, an image in each of its formats; then the code.
const modes = [
  ...(t.root === "Canvas"
    ? t.formats.length
      ? t.formats.map((f) => ({ id: f, label: f.charAt(0).toUpperCase() + f.slice(1) }))
      : [{ id: "image", label: "Image" }]
    : t.root === "Document"
      ? [{ id: "desktop", label: "Page" }, { id: "pdf", label: "PDF" }]
      : [{ id: "desktop", label: "Desktop" }, { id: "phone", label: "Phone" }, ...(t.root === "Email" ? [{ id: "text", label: "Plain text" }] : [])]),
  { id: "code", label: "Code" },
];
const shownFormats = t.formats.length ? (t.root === "Canvas" ? t.formats : [t.formats[0]]) : ["default"];
const starter = `template-${t.folder}-${t.name}`;
const swatch = (colors: Record<string, string>) => `background:linear-gradient(135deg, ${colors.background ?? "#fff"} 50%, ${colors.primary ?? "#888"} 50%)`;
---
<Base title={`${t.label}: ${t.output} template`} description={`${t.description}. A ${t.output.toLowerCase()} template${t.recreates ? `, a recreation of ${t.recreates.company}'s ${t.recreates.what},` : ""} previewed in each sample brand, with one file to copy.`}>
  <section class="wrap t-top">
    <div class="t-row">
      <div class="t-id">
        <a class="back" href="/templates">← Templates</a>
        <span class="t-sep" aria-hidden="true"></span>
        <h1>{t.label}</h1>
      </div>
      <div class="t-actions">
        {list.map((b, i) => <button class="btn btn-primary" type="button" data-brand={b.id} hidden={i !== 0} data-copy={t.byBrand[b.id]?.single ?? ""} title="One file, with the brand written in">Copy the code</button>)}
        <a class="btn btn-ghost" href={`/playground#starter=${starter}`}>Open in the playground</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="stage panel" data-stage data-show="preview" style={pdfWidth}>
      <div class="stage-bar">
        <div class="seg" role="tablist" aria-label="View">
          {modes.map((m, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-mode-pick={m.id}>{m.label}</button>)}
        </div>
        <div class="brand-pick">
          <span class="in" id="brand-label">In <strong data-brand-name>{list[0]!.name}</strong></span>
          <div class="swatches" role="radiogroup" aria-labelledby="brand-label">
            {list.map((b, i) => <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-brand-pick={b.id} data-name={b.name} aria-label={b.name} title={b.name} style={swatch(b.colors)}></button>)}
          </div>
        </div>
      </div>
      <div class="stage-preview">
        {list.map((b, i) => (
          <div data-brand={b.id} hidden={i !== 0}>
            {shownFormats.map((format, j) => {
              const ex = t.byBrand[b.id]?.views[format];
              return ex && (
                <div data-format={format} hidden={t.root === "Canvas" && j !== 0}>
                  <Preview example={ex} views={[...views]} width={width} height={t.root === "Canvas" ? 640 : 820} full />
                </div>
              );
            })}
          </div>
        ))}
      </div>
      <div class="stage-code" hidden>
        <div class="code-bar">
          <span class="file">{file}</span>
          <button class="btn-link" type="button" aria-expanded="false" aria-controls="brand-file" data-brand-toggle>Show brand.ts</button>
        </div>
        <CodeBlock code={t.code} color />
        <div id="brand-file" class="brand-file" hidden>
          {list.map((b, i) => (
            <div data-brand={b.id} hidden={i !== 0}>
              <p class="code-bar"><span class="file">brand.ts</span><span class="note">{b.name}: put yours here</span></p>
              <CodeBlock code={t.byBrand[b.id]?.brandFile ?? ""} lang="ts" color />
            </div>
          ))}
        </div>
        <p class="one-file">
          {list.map((b, i) => <span data-brand={b.id} hidden={i !== 0}>Or <button class="btn-link" type="button" data-copy={t.byBrand[b.id]?.single ?? ""}>copy it as one file</button>, with {b.name} written in.</span>)}
        </p>
      </div>
    </div>

  </div>
</Base>

<script>
  // The stage shows one thing: the preview in the view picked, or the code. The views drive each brand's preview
  // (its own tabs are hidden); an image's are its formats instead.
  const stage = document.querySelector<HTMLElement>("[data-stage]");
  if (stage) {
    const preview = stage.querySelector<HTMLElement>(".stage-preview")!;
    const code = stage.querySelector<HTMLElement>(".stage-code")!;
    const modes = [...stage.querySelectorAll<HTMLButtonElement>("[data-mode-pick]")];
    const formats = [...stage.querySelectorAll<HTMLElement>("[data-format]")];
    const byFormat = formats.some((f) => modes.some((m) => m.dataset.modePick === f.dataset.format));
    modes.forEach((m) =>
      m.addEventListener("click", () => {
        const id = m.dataset.modePick!;
        modes.forEach((x) => x.setAttribute("aria-selected", String(x === m)));
        const what = id === "code" ? "code" : "preview";
        stage.dataset.show = what;
        preview.hidden = what !== "preview";
        code.hidden = what !== "code";
        if (what === "preview") {
          if (byFormat) formats.forEach((f) => (f.hidden = f.dataset.format !== id));
          else {
            // A PDF is as tall as its page view, plus the viewer's own bar.
            if (id === "pdf") stage.querySelectorAll<HTMLElement>(".preview").forEach((p) => {
              const page = p.querySelector<HTMLElement>('.view-frame[data-view="desktop"]');
              if (page?.style.height) p.style.setProperty("--pdf-h", `${parseFloat(page.style.height) + 56}px`);
            });
            stage.querySelectorAll<HTMLButtonElement>(`.preview [role="tab"][data-view="${id}"]`).forEach((tab) => tab.click());
          }
        }
        window.dispatchEvent(new Event("resize"));
      }),
    );
    const toggle = stage.querySelector<HTMLButtonElement>("[data-brand-toggle]")!;
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      toggle.textContent = open ? "Hide brand.ts" : "Show brand.ts";
      document.getElementById("brand-file")!.hidden = !open;
    });
  }

  // The brand: every [data-brand] element shows the one picked. It comes from the address (?brand=, as the gallery's
  // cards link), else the gallery's pick in this browser, else the first: a recreation's own brand, or the docs' brand.
  const KEY = "templates.brand";
  const swatches = [...document.querySelectorAll<HTMLElement>("[data-brand-pick]")];
  const ids = swatches.map((b) => b.dataset.brandPick!);
  const recreation = ids[0]!.endsWith("-original");
  const pick = (id: string, remember: boolean) => {
    if (!ids.includes(id)) return;
    document.querySelectorAll<HTMLElement>("[data-brand]").forEach((el) => (el.hidden = el.dataset.brand !== id));
    // A lazy frame that started out hidden may not load once shown: the picked brand's previews load now.
    document.querySelectorAll<HTMLIFrameElement>(`.stage-preview [data-brand="${id}"] iframe[loading="lazy"]`).forEach((frame) => (frame.loading = "eager"));
    swatches.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.brandPick === id)));
    document.querySelector<HTMLElement>("[data-brand-name]")!.textContent = swatches.find((b) => b.dataset.brandPick === id)!.dataset.name!;
    if (remember) {
      try {
        if (id.endsWith("-original")) localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, id);
      } catch {}
      const url = new URL(location.href);
      url.searchParams.set("brand", id);
      history.replaceState(history.state, "", url);
    }
    // The previews fit themselves to their panels on resize.
    window.dispatchEvent(new Event("resize"));
  };
  swatches.forEach((b) => b.addEventListener("click", () => pick(b.dataset.brandPick!, true)));
  let saved: string | null = null;
  try {
    saved = localStorage.getItem(KEY);
  } catch {}
  const asked = new URLSearchParams(location.search).get("brand") ?? (recreation ? null : saved);
  if (asked) pick(asked, false);
</script>

<style>
  /* One brand's copy of each part shows at a time; a button's own display doesn't bring the others back. */
  [data-brand][hidden] { display: none !important; }
  .t-top { padding-top: 20px; padding-bottom: 14px; }
  .t-row { display: flex; justify-content: space-between; align-items: center; gap: 12px 24px; flex-wrap: wrap; }
  .t-id { display: flex; align-items: center; gap: 8px 14px; flex-wrap: wrap; min-width: 0; }
  .back { color: var(--text-3); text-decoration: none; font-size: 14px; }
  .back:hover { color: var(--text); }
  .t-sep { width: 1px; height: 18px; background: var(--line-2); }
  .t-id h1 { margin: 0; font-size: 24px; letter-spacing: -0.01em; }
  .t-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .t-actions .btn { padding: 8px 14px; font-size: 13.5px; }
  .t-actions .btn[data-copied]::after { content: " ✓"; }
  .btn-link { background: none; border: 0; padding: 0; color: var(--text-2); font: 13px var(--sans); text-decoration: underline; cursor: pointer; }
  .btn-link[data-copied]::after { content: " ✓"; }
  .stage { padding: 0; overflow: hidden; background: var(--bg-2, #0e0e0e); }
  .stage-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px 16px; padding: 10px 12px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .seg { display: inline-flex; gap: 2px; padding: 3px; border: 1px solid var(--line-2); border-radius: 999px; }
  .seg button { padding: 5px 14px; border: 0; border-radius: 999px; background: transparent; color: var(--text-2); font: 13px var(--sans); cursor: pointer; white-space: nowrap; }
  .seg button[aria-selected="true"] { background: var(--text); color: var(--bg); }
  .brand-pick { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .in { font-size: 13px; color: var(--text-3); }
  .in strong { color: var(--text); font-weight: 600; }
  .swatches { display: flex; gap: 4px; flex-wrap: wrap; }
  .swatches button { width: 22px; height: 22px; padding: 0; border-radius: 999px; cursor: pointer; border: 2px solid var(--bg-2, #0e0e0e); box-shadow: 0 0 0 1px var(--line-2); }
  .swatches button[aria-checked="true"] { box-shadow: 0 0 0 2px var(--text); }
  .swatches button:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; }
  .stage :global(.preview .tabs) { display: none; }
  .stage :global(.preview .view-frame .scaler) { margin: 0 auto; }
  .stage-code { min-height: 760px; display: flex; flex-direction: column; }
  .stage-code[hidden] { display: none; }
  /* A document's PDF at the width its page is drawn, as tall as the page view was. */
  .stage :global(.preview.full .view-file:has(iframe)) { max-width: var(--pdf-w); margin: 0 auto; height: var(--pdf-h, 820px); }
  .code-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 0; padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .file { font: 12.5px var(--mono); color: var(--text); }
  .note { font-size: 13px; color: var(--text-3); }
  .stage-code :global(.code-block) { margin: 0; border: 0; border-radius: 0; }
  .stage-code > :global(.code-block) { max-height: 900px; overflow: auto; }
  .brand-file { border-top: 1px solid var(--line); }
  .one-file { margin: auto 0 0; padding: 12px 14px; border-top: 1px solid var(--line); font-size: 13px; color: var(--text-3); }
  @media (max-width: 640px) {
    .seg { max-width: 100%; overflow-x: auto; scrollbar-width: none; }
    .t-sep { display: none; }
  }
</style>

---
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Cmd from "../../components/Cmd.astro";
import { site } from "../../lib/site";
import { template } from "../../lib/examples";
// The same email in both: a React Email template, and what `npx @hyper-elements/migrate` wrote for it.
import before from "../../generated/migrate/before.tsx?raw";
import after from "../../generated/migrate/after.tsx?raw";

// The page reads as evergreen: no versions or dates on it. Its facts were last checked against react-email 6.11.13
// and Hyper Elements 0.4 on November 14, 2026. React Email ships often: check its docs and its preview server's
// source (@react-email/ui: the toolbar's compatibility checker, linter and spam score) when either side changes.

// For search: the page answers "react email alternative" and "react email vs". The title names the brand already, so
// it goes out with no " · Hyper Elements" after it.
const title = "Hyper Elements vs React Email";
const metaTitle = "React Email alternative: Hyper Elements vs React Email";
const description =
  "Looking for a React Email alternative? Compare Hyper Elements and React Email side by side: layout, checks, email client previews, themes and agent speed.";

// Agent benchmark (/docs/benchmark, 2026-11-08): the same five emails, 16 runs each, the same checks. Lower is better.
const bench = "/docs/benchmark";
const race = [
  { k: "Time to a passing email", x: "2.6× faster", he: 33, re: 86, fmt: (n: number) => `${n}s` },
  { k: "Output tokens the agent wrote", x: "3.4× fewer", he: 1831, re: 6215, fmt: (n: number) => n.toLocaleString("en-US") },
  { k: "Turns", x: "Half as many", he: 9, re: 18, fmt: (n: number) => String(n) },
];
const pct = (n: number, max: number) => `width: ${((n / max) * 100).toFixed(1)}%`;

// At a glance: "yes", "part" (with a short note) or "no" for each side. Hyper Elements' wins first.
type Mark = "yes" | "part" | "no";
const matrix: { k: string; he: Mark; heNote?: string; re: Mark; reNote?: string }[] = [
  { k: "Accessibility lint", he: "yes", heNote: "18 rules", re: "part", reNote: "Alt text" },
  { k: "Email client previews", he: "yes", heNote: "7 clients, free", re: "no" },
  { k: "Email client support checks", he: "yes", heNote: "render(), CLI, CI", re: "part", reNote: "Preview window" },
  { k: "Brand theme with tokens", he: "yes", heNote: "defineTheme()", re: "part", reNote: "Tailwind config" },
  { k: "Variants from the theme", he: "yes", heNote: "variant=\"secondary\"", re: "no" },
  { k: "Widths and Outlook tables worked out", he: "yes", re: "part", reNote: "You space blocks" },
  { k: "Template checked when it renders", he: "yes", heNote: "With the fix", re: "no" },
  { k: "Web pages", he: "yes", re: "no" },
  { k: "PDFs", he: "yes", re: "no" },
  { k: "PNG and SVG images", he: "yes", re: "no" },
  { k: "Agent skill and JSON CLI", he: "yes", re: "part", reNote: "llms.txt" },
  { k: "HTML and plain text", he: "yes", heNote: "One call", re: "yes", reNote: "Two calls" },
  { k: "Local preview server", he: "yes", re: "yes" },
  { k: "Visual editor", he: "yes", heNote: "Drag and drop (Unlayer)", re: "part", reNote: "Rich text (Tiptap)" },
  { k: "Any email provider", he: "yes", re: "yes" },
  { k: "Open source, MIT", he: "yes", re: "yes" },
];
const label: Record<Mark, string> = { yes: "Yes", part: "Partly", no: "No" };

// On brand: one email (examples/brand/announcement.tsx) rendered with two themes (examples/showcase/brand-*.tsx).
const brands = [
  { name: "North", theme: "north", img: "/generated/compare/brand-north.jpg", w: 620, h: 470 },
  { name: "Bloom", theme: "bloom", img: "/generated/compare/brand-bloom.jpg", w: 620, h: 470 },
];
const brandCode = `<Email theme={north}>
  <Column style={{ apply: ["card"] }}>
    <Heading level={1}>The winter collection…</Heading>
    <Text>Everything you asked for…</Text>
    <Button href="…">Shop the drop</Button>
    <Button href="…" variant="secondary">
      See the lookbook
    </Button>
  </Column>
</Email>`;
const brandParts = [
  { t: "Tokens", d: "Colors, fonts, sizes, spacing and corners, checked when the template is read" },
  { t: "Defaults and variants", d: "Every Button, Heading and Divider styled once, with named versions" },
  { t: "Everywhere", d: "The same theme brands emails, pages, PDFs and images" },
];

// One template, four outputs: real output of the site's templates, as images (scripts/compare-previews.mjs; the
// Canvas is its own PNG from generate), so their copy isn't read as this page's text.
const outputs = [
  { kind: "Email", ex: template("oyen-launch"), img: "/generated/compare/oyen-launch.jpg", w: 620, h: 589, href: "/docs/outputs/email" },
  { kind: "Web page", ex: template("casa-albero-page"), img: "/generated/compare/casa-albero-page.jpg", w: 900, h: 855, href: "/docs/outputs/page" },
  { kind: "PDF", ex: template("pell-ashby-invoice"), img: "/generated/compare/pell-ashby-invoice.jpg", w: 860, h: 817, href: "/docs/outputs/pdf" },
  { kind: "Image", ex: template("fernway-spring-sale"), img: "/generated/templates/fernway-spring-sale.png", w: 1080, h: 1080, href: "/docs/outputs/image" },
];

// The email client emulator: each client and how closely it matches the real one (/docs/email-client-emulator).
const emulatorClients = [
  { name: "Classic Outlook", acc: "97%" },
  { name: "Outlook.com", acc: "99%" },
  { name: "Gmail", acc: "99%" },
  { name: "Gmail app", acc: "98%" },
  { name: "Apple Mail", acc: "98%" },
  { name: "Yahoo Mail", acc: "99%" },
  { name: "AOL Mail", acc: "99%" },
];
const emulatorPoints = [
  { t: "Free", d: "No account, key or limit" },
  { t: "Local", d: "Nothing sent or uploaded" },
  { t: "Light and dark", d: "Desktop and phones" },
  { t: "Fast", d: "As long as a render" },
];

// Each question here is also the page's FAQPage for search engines, so keep the answers plain text.
const faq = [
  {
    q: "What are the alternatives to React Email?",
    a: "The main ones are Hyper Elements, MJML, Maizzle and jsx-email. Hyper Elements is React components too, and also works out the layout, checks the email, previews it in email clients, keeps it on brand with a theme, and renders the same template as a page, a PDF or an image. MJML is a markup language of its own that compiles to email HTML, and doesn't need React. Maizzle builds HTML emails with Tailwind CSS. jsx-email is JSX components close to React Email's.",
  },
  {
    q: "Is Hyper Elements built on React Email?",
    a: "No. Hyper Elements has its own components, layout engine and writers. It doesn't use React Email, and React Email isn't needed to run it.",
  },
  {
    q: "Can I preview my emails in Outlook, Gmail and Apple Mail?",
    a: "Yes, for free. Hyper Elements comes with an email client emulator, @hyper-elements/email-clients, that previews classic Outlook, Outlook.com, Gmail, the Gmail app, Apple Mail, Yahoo Mail and AOL Mail on your machine, in light and dark mode, with no test sends or account. React Email's preview server lists HTML and CSS a client doesn't support, but doesn't preview the email in each client. The emulator also takes any HTML email, so you can preview React Email templates with it too.",
  },
  {
    q: "How do I keep every email on brand?",
    a: "Write the brand once with defineTheme(): colors, fonts, sizes, spacing and corners as tokens, each component's defaults, its variants, and named styles. Give it to any root with theme, and every email, page, PDF and image that takes it is on brand. React Email shares a brand through a Tailwind config passed to each Tailwind wrapper, with no component variants.",
  },
  {
    q: "Can I use Tailwind with Hyper Elements?",
    a: "Not as classes, and that's on purpose. Tailwind was made in 2017, before coding agents, to help people write CSS faster: short class names, and no switching between files. An agent doesn't need shortcuts; it needs feedback. Hyper Elements' styles are typed objects, so a style that doesn't exist is a TypeScript error, and validate() says what's wrong and what to write instead, where a misspelled or unsupported Tailwind class does nothing and says nothing. Phone styles go in a mobile block and hover styles in a hover block. When you migrate, Tailwind classes in your React Email templates are resolved with your Tailwind config and become styles.",
  },
  {
    q: "Can I keep my React Email templates?",
    a: "Yes. npx @hyper-elements/migrate converts each template and checks it against the original before it writes anything. Or keep them as they are and test their HTML with @hyper-elements/email-clients, which takes HTML from React Email.",
  },
  {
    q: "Does Hyper Elements work with Resend?",
    a: "Yes. render() gives you the HTML and the plain text as two strings; pass them to Resend, or any other provider's SDK.",
  },
  {
    q: "Which is faster for a coding agent?",
    a: "In our benchmark, Claude Code reached a passing email 2.6× faster with Hyper Elements than with React Email, writing 3.4× fewer output tokens, across five briefs and 16 runs each. It's one agent and one model on short, fully specified emails. The harness is in the repository, so you can run it with your own agent.",
  },
];

const url = new URL("/compare/react-email", site.url).href;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: title, description, url, inLanguage: "en", isPartOf: { "@type": "WebSite", name: site.name, url: site.url } },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
];
---
<Base title={metaTitle} titleSuffix={false} description={description} jsonLd={jsonLd}>
  <section class="c-hero">
    <div class="wrap c-hero-inner">
      <h1 class="h-page">Hyper Elements vs React&nbsp;Email</h1>
      <p class="lede">Both write emails in React. Hyper Elements also lays them out, checks them, shows them in every email client, and renders them on-brand.</p>
      <div class="c-cta">
        <a class="btn btn-primary" href="/docs/quickstart">Get started <span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="/migrate">Migrate from React Email</a>
      </div>
    </div>

    {/* The scoreboard: the agent benchmark as bars, Hyper Elements' bar lit. */}
    <div class="wrap">
      <a class="board reveal" href={bench} aria-label="Agent benchmark: Hyper Elements and React Email">
        <div class="board-head">
          <span class="board-title">Same five emails, built by a coding agent</span>
          <span class="legend" aria-hidden="true"><span class="lg he"><i></i>Hyper Elements</span><span class="lg re"><i></i>React Email</span></span>
        </div>
        <div class="race">
          {race.map((r) => {
            const max = Math.max(r.he, r.re);
            return (
              <div class="race-row">
                <div class="race-k"><span>{r.k}</span><b>{r.x}</b></div>
                <div class="race-bars">
                  <span class="rb he"><span class="rb-bar"><i style={pct(r.he, max)}></i></span><span class="rb-n"><span class="sr">Hyper Elements </span>{r.fmt(r.he)}</span></span>
                  <span class="rb re"><span class="rb-bar"><i style={pct(r.re, max)}></i></span><span class="rb-n"><span class="sr">React Email </span>{r.fmt(r.re)}</span></span>
                </div>
              </div>
            );
          })}
        </div>
        <p class="board-note">Medians of 16 runs each, with Claude Code. Every Hyper Elements run passed the first check; 12 of 16 React Email runs did. <span class="board-more">The benchmark →</span></p>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h-section">Hyper Elements vs React Email at a glance</h2>
        <p class="sec-sub">What you get with each, side by side, if you’re weighing a React Email alternative.</p>
      </div>
      <div class="mx reveal" role="table" aria-label="Hyper Elements and React Email, feature by feature">
        <div class="mx-row mx-head" role="row">
          <span role="columnheader"><span class="sr">Feature</span></span>
          <span class="mx-col he" role="columnheader"><span class="he-dot" aria-hidden="true"></span>Hyper Elements</span>
          <span class="mx-col" role="columnheader">React Email</span>
        </div>
        {matrix.map((m) => (
          <div class="mx-row" role="row">
            <span class="mx-k" role="rowheader">{m.k}</span>
            <span class="mx-c he" role="cell">
              <span class:list={["mk", m.he]} title={label[m.he]}><span class="sr">{label[m.he]}</span></span>
              {m.heNote && <span class="mx-note">{m.heNote}</span>}
            </span>
            <span class="mx-c" role="cell">
              <span class:list={["mk", m.re]} title={label[m.re]}><span class="sr">{label[m.re]}</span></span>
              {m.reNote && <span class="mx-note">{m.reNote}</span>}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="emu reveal">
        <div class="emu-copy">
          <p class="eyebrow ok">Included free</p>
          <h2 class="emu-title">See it in Outlook, Gmail, Apple Mail and Yahoo Mail before you send</h2>
          <p class="emu-sub">React Email lists CSS a client doesn't support. Hyper Elements shows you what the client does with it.</p>
          <ul class="emu-points">
            {emulatorPoints.map((p) => <li><b>{p.t}</b><span>{p.d}</span></li>)}
          </ul>
          <div class="c-cta left">
            <a class="btn btn-primary btn-sm" href="/email-testing">Try it in your browser <span class="arrow">→</span></a>
            <a class="btn btn-ghost btn-sm" href="/docs/email-client-emulator">Read the docs</a>
          </div>
        </div>
        <div class="emu-side">
          <a class="emu-stage" href="/email-testing" aria-label="Try the email client emulator: classic Outlook, Apple Mail, the Gmail app and more">
            <figure class="emu-win emu-back"><img src="/generated/email-clients/launch-apple-mail.png" width="820" height="985" alt="" loading="lazy" decoding="async" /><figcaption>Apple Mail</figcaption></figure>
            <figure class="emu-win emu-front"><img src="/generated/email-clients/launch-outlook.png" width="820" height="989" alt="" loading="lazy" decoding="async" /><figcaption>Classic Outlook</figcaption></figure>
            <figure class="emu-phone"><img src="/generated/email-clients/launch-gmail-app.png" width="380" height="997" alt="" loading="lazy" decoding="async" /><figcaption>Gmail app</figcaption></figure>
          </a>
          <ul class="emu-clients" aria-label="Email clients and how closely each preview matches the real client">
            {emulatorClients.map((c) => <li><span>{c.name}</span><b>{c.acc}</b></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h-section">On brand, in every email</h2>
        <p class="sec-sub">Write your brand once as a theme. The template names no colors or fonts; swap the theme and the same email is someone else's.</p>
      </div>
      <div class="brand-shots reveal">
        {brands.map((b) => (
          <figure class="brand-shot">
            <img src={b.img} width={b.w} height={b.h} alt={`The same announcement email with the ${b.name} theme`} loading="lazy" decoding="async" />
            <figcaption><code>theme=&#123;{b.theme}&#125;</code><span>{b.name}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="brand-row reveal">
        <div class="brand-code">
          <CodeBlock code={brandCode} file="emails/announcement.tsx" />
        </div>
        <div class="brand-side">
          <ul class="brand-parts">
            {brandParts.map((p) => <li><b>{p.t}</b><span>{p.d}</span></li>)}
          </ul>
          <p class="brand-re"><span class="mk part" aria-hidden="true"></span><span>React Email: a Tailwind config on each &lt;Tailwind&gt; wrapper, with no component variants.</span></p>
          <a class="brand-more" href="/docs/themes">How themes work →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h-section">One template, four outputs</h2>
        <p class="sec-sub">React Email writes emails. Change a Hyper Elements template's root and the same content becomes a page, a PDF or an image.</p>
      </div>
      <div class="outs">
        {outputs.map((o) => (
          <a class="out reveal" href={o.href}>
            <img class="out-img" src={o.img} width={o.w} height={o.h} alt={`${o.ex.title}, a Hyper Elements ${o.kind === "Image" ? "image" : o.kind === "PDF" ? "PDF" : o.kind.toLowerCase()}`} loading="lazy" decoding="async" />
            <span class="out-label"><span class="out-root">&lt;{o.ex.root}&gt;</span><b>{o.kind}</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h-section">The same email in React Email and Hyper Elements</h2>
        <p class="sec-sub">No margins to juggle: the parent's gap spaces the blocks.</p>
      </div>
      <div class="ba reveal">
        <div class="ba-side">
          <p class="ba-label"><span class="ba-name"><span class="he-dot" aria-hidden="true"></span>Hyper Elements</span> <a class="ba-stats now" href={bench} title="Median time and output tokens for a coding agent to write a passing email with Hyper Elements"><span>{race[0].fmt(race[0].he)}</span><span>{race[1].fmt(race[1].he)} tokens</span></a></p>
          <CodeBlock code={after.trim()} file="emails/welcome.tsx" />
        </div>
        <div class="ba-side">
          <p class="ba-label"><span class="ba-name re">React Email</span> <a class="ba-stats was" href={bench} title="Median time and output tokens for a coding agent to write a passing email with React Email"><span>{race[0].fmt(race[0].re)}</span><span>{race[1].fmt(race[1].re)} tokens</span></a></p>
          <CodeBlock code={before.trim()} file="emails/welcome.tsx" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq-wrap">
      <h2 class="h-section reveal">Questions about switching from React Email</h2>
      <div class="faq reveal">
        {faq.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section final">
    <div class="wrap final-inner reveal">
      <h2 class="h-section">Switch from React Email in one command</h2>
      <p class="sec-sub">Converts every template, checks each against the original, and writes nothing until you ask.</p>
      <Cmd text={`${site.migrate} src/emails`} />
      <div class="c-cta">
        <a class="btn btn-primary" href="/migrate">How migrating works <span class="arrow">→</span></a>
        <a class="btn btn-ghost" href="/docs/quickstart">Start from scratch</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .he-dot { display: inline-block; width: 8px; height: 8px; border-radius: 999px; background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 18%, transparent); flex: none; }
  .eyebrow { margin: 0; font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-3); }
  .eyebrow.ok { color: var(--ok); }
  .sec-head { text-align: center; margin: 0 auto 48px; max-width: 680px; }
  .sec-head .h-section { margin: 0; }
  .sec-sub { margin: 12px 0 0; color: var(--text-2); font-size: 17px; line-height: 1.55; }
  .c-cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: center; }
  .c-cta.left { justify-content: flex-start; }

  /* Hero, with a glow behind the scoreboard. */
  .c-hero { position: relative; padding: clamp(40px, 6vh, 80px) 0 0; }
  .c-hero::before { content: ""; position: absolute; inset: 160px 0 auto; height: 520px; pointer-events: none; background: radial-gradient(50% 60% at 50% 40%, color-mix(in srgb, var(--ok) 12%, transparent), transparent 70%); }
  .c-hero-inner { position: relative; display: grid; justify-items: center; text-align: center; gap: 14px; grid-template-columns: minmax(0, 1fr); }
  .c-hero .h-page { margin: 0; }
  .c-hero .lede { margin: 0 auto; max-width: 56ch; }
  .c-hero .c-cta { margin-top: 10px; }

  /* The scoreboard. */
  .board { position: relative; display: block; margin-top: 56px; padding: 32px; border: 1px solid var(--line-2); border-radius: 18px; background: linear-gradient(180deg, var(--bg-2), var(--bg-1)); box-shadow: var(--shadow); color: inherit; text-decoration: none; transition: border-color 0.2s; }
  .board:hover, .board:focus-visible { border-color: var(--line-3); }
  .board-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; margin-bottom: 28px; }
  .board-title { font-size: 17px; font-weight: 600; letter-spacing: -0.015em; }
  .legend { display: flex; gap: 18px; font-size: 13px; color: var(--text-2); }
  .lg { display: inline-flex; align-items: center; gap: 8px; }
  .lg i { width: 14px; height: 8px; border-radius: 0 4px 4px 0; }
  .lg.he i { background: var(--ok); }
  .lg.re i { background: var(--text-3); opacity: 0.5; }
  .race { display: grid; gap: 26px; }
  .race-row { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 28px; align-items: center; }
  .race-k { display: grid; gap: 2px; }
  .race-k span { font-size: 14px; color: var(--text-2); }
  .race-k b { font-size: 30px; font-weight: 600; letter-spacing: -0.04em; line-height: 1.1; color: var(--text); }
  .race-bars { display: grid; gap: 8px; min-width: 0; }
  .rb { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .rb-bar { flex: 1 1 auto; display: flex; height: 14px; }
  .rb-bar i { display: block; height: 100%; border-radius: 0 7px 7px 0; }
  .rb.he .rb-bar i { background: linear-gradient(90deg, color-mix(in srgb, var(--ok) 55%, transparent), var(--ok)); }
  .rb.re .rb-bar i { background: var(--text-3); opacity: 0.45; }
  .rb-n { flex: none; width: 52px; font: 500 13px var(--mono); font-variant-numeric: tabular-nums; color: var(--text-2); }
  .rb.he .rb-n { color: var(--text); }
  .board-note { margin: 28px 0 0; padding-top: 18px; border-top: 1px solid var(--line); font-size: 13px; line-height: 1.55; color: var(--text-3); }
  .board-more { color: var(--text-2); white-space: nowrap; }
  .board:hover .board-more { color: var(--text); }

  /* At a glance: a check matrix, the Hyper Elements column lit. */
  .mx { max-width: 920px; margin: 0 auto; border: 1px solid var(--line); border-radius: 16px; background: var(--bg-1); overflow: hidden; }
  .mx-row { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr); border-top: 1px solid var(--line); }
  .mx-row > * { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 13px 22px; }
  .mx-head { border-top: 0; }
  .mx-head > * { padding-top: 18px; padding-bottom: 18px; }
  .mx-col { font-size: 14px; font-weight: 600; color: var(--text-2); }
  .mx-col.he { color: var(--text); }
  .mx-k { font-size: 15px; color: var(--text); }
  .mx-c.he { background: color-mix(in srgb, var(--ok) 6%, transparent); border-left: 1px solid color-mix(in srgb, var(--ok) 22%, transparent); border-right: 1px solid color-mix(in srgb, var(--ok) 22%, transparent); }

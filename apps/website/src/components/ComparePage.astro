---
import Base from "../layouts/Base.astro";
import CodeBlock from "./CodeBlock.astro";
import Cmd from "./Cmd.astro";
import { site } from "../lib/site";
import { showcase, template } from "../lib/examples";
import { alternatives, comparisons, hubs } from "../lib/compare-pages";

// A comparison page, /compare/<slug>: Hyper Elements against one other tool. Each page in src/pages/compare/ gives the
// other tool's facts; the email client emulator, the themes and the four outputs are Hyper Elements' own, the same on
// every page. Keep each page evergreen: no versions or dates on it (put what it was checked against in a comment).

export type Mark = "yes" | "part" | "no";
/** One row of "at a glance": a mark for each side, with a short note. */
export type Row = { k: string; he: Mark; heNote?: string; re: Mark; reNote?: string };
/** One bar pair of the scoreboard, from the agent benchmark (/docs/benchmark). Lower is better. */
export type Race = { k: string; x: string; he: number; re: number; fmt: (n: number) => string };
type Link = { label: string; href: string };
type Code = { code: string; lang?: string; file: string };

interface Props {
  /** The page's path, for its canonical URL and structured data. */
  path: string;
  /** The other tool, as it names itself. */
  name: string;
  /** "a" or "an", before the name ("an MJML alternative"). */
  article?: string;
  metaTitle: string;
  description: string;
  lede: string;
  /** The hero's buttons, the first one primary. */
  ctas: Link[];
  /** The scoreboard: time, then output tokens (the code section shows those two), then any more. */
  race: Race[];
  raceNote: string;
  matrix: Row[];
  emuSub: string;
  brandNote: string;
  /** One line on how the other tool checks an email, under the diagnostics. */
  checksNote: string;
  code: { sub: string; he: Code; other: Code };
  faqTitle: string;
  /** Plain text: it's also the page's FAQPage for search engines. */
  faq: { q: string; a: string }[];
  final: { title: string; sub: string; cmd: string; ctas: Link[] };
}
const { path, name, article = "a", metaTitle, description, lede, ctas, race, raceNote, matrix, emuSub, brandNote, checksNote, code, faqTitle, faq, final } = Astro.props;

const bench = "/docs/benchmark";
// Every comparison and alternatives page (src/lib/compare-pages.ts): each links to the others.
const others = comparisons.filter((c) => c.path !== path);
const pct = (n: number, max: number) => `width: ${((n / max) * 100).toFixed(1)}%`;

const label: Record<Mark, string> = { yes: "Yes", part: "Partly", no: "No" };

// On brand: one email (examples/brand/announcement.tsx) rendered with two themes (examples/showcase/brand-*.tsx).
const brands = [
  { name: "North", theme: "north", img: "/generated/compare/brand-north.jpg", w: 620, h: 470 },
  { name: "Bloom", theme: "bloom", img: "/generated/compare/brand-bloom.jpg", w: 620, h: 470 },
];
const brandCode = `<Email theme={north}>
  <Column style={{ apply: ["card"] }}>
    <Heading level={1}>The winter collection…</Heading>
    <Text>Everything you asked for…</Text>
    <Button href="…">Shop the drop</Button>
    <Button href="…" variant="secondary">
      See the lookbook
    </Button>
  </Column>
</Email>`;
const brandParts = [
  { t: "Tokens", d: "Colors, fonts, sizes, spacing and corners, checked when the template is read" },
  { t: "Defaults and variants", d: "Every Button, Heading and Divider styled once, with named versions" },
  { t: "Everywhere", d: "The same theme brands emails, pages, PDFs and images" },
];

// Checked as it renders: what render() returned for the site's launch email (examples/showcase/email.tsx, from
// examples.json), one line per kind, after the error a margin gets (validate()'s own message, from the diagnostics docs).
const seen = new Set<string>();
const clientNotes = showcase.email.diagnostics
  .filter((d) => d.code !== "email/phone-styles" && !seen.has(d.message.split(" on this ")[0]) && seen.add(d.message.split(" on this ")[0]))
  .slice(0, 4);
const checks = [
  { severity: "error", code: "style/unknown", message: "\"marginBottom\" isn't a style a Text takes: use the parent's gap, or padding." },
  ...clientNotes.map((d) => ({ severity: d.severity, code: d.code, message: d.message })),
];
const checkPoints = [
  { t: "In your code", d: "render() and validate() return them, with where each one is" },
  { t: "In CI", d: "The CLI's check exits 1 on an error, with --json for scripts" },
  { t: "With the fix", d: "Each one says what to write instead, so an agent fixes it itself" },
];

// Beyond email: a page, a PDF and an image, real output of the site's templates, as images (scripts/compare-previews.mjs; the
// Canvas is its own PNG from generate), so their copy isn't read as this page's text.
const outputs = [
  { kind: "Web page", ex: template("casa-albero-page"), img: "/generated/compare/casa-albero-page.jpg", w: 900, h: 855, href: "/docs/outputs/page" },
  { kind: "PDF", ex: template("pell-ashby-invoice"), img: "/generated/compare/pell-ashby-invoice.jpg", w: 860, h: 817, href: "/docs/outputs/pdf" },
  { kind: "Image", ex: template("fernway-spring-sale"), img: "/generated/templates/fernway-spring-sale.png", w: 1080, h: 1080, href: "/docs/outputs/image" },
];

// The email client emulator: each client and how closely it matches the real one (/docs/email-client-emulator).
const emulatorClients = [
  { name: "Classic Outlook", acc: "97%" },
  { name: "Outlook.com", acc: "99%" },
  { name: "Gmail", acc: "99%" },
  { name: "Gmail app", acc: "98%" },
  { name: "Apple Mail", acc: "98%" },
  { name: "Yahoo Mail", acc: "99%" },
  { name: "AOL Mail", acc: "99%" },
];
const emulatorPoints = [
  { t: "Free", d: "No account, key or limit" },
  { t: "Local", d: "Nothing sent or uploaded" },
  { t: "Light and dark", d: "Desktop and phones" },
  { t: "Fast", d: "As long as a render" },
];

const title = `Hyper Elements vs ${name}`;
const url = new URL(path, site.url).href;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: title, description, url, inLanguage: "en", isPartOf: { "@type": "WebSite", name: site.name, url: site.url } },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: site.name, item: site.url },
      { "@type": "ListItem", position: 2, name: hubs.compare.name, item: new URL(hubs.compare.path, site.url).href },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
];
---
<Base title={metaTitle} titleSuffix={false} description={description} jsonLd={jsonLd}>
  <section class="c-hero">
    <div class="wrap c-hero-inner">
      <h1 class="h-page">Hyper Elements vs {name.replace(" ", "\u00a0")}</h1>
      <p class="lede">{lede}</p>
      <div class="c-cta">
        {ctas.map((c, i) => i === 0 ? <a class="btn btn-primary" href={c.href}>{c.label} <span class="arrow">→</span></a> : <a class="btn btn-ghost" href={c.href}>{c.label}</a>)}
      </div>
    </div>

    {/* The scoreboard: the agent benchmark as bars, Hyper Elements' bar lit. */}
    <div class="wrap">
      <a class="board reveal" href={bench} aria-label={`Agent benchmark: Hyper Elements and ${name}`}>
        <div class="board-head">
          <span class="board-title">Same five emails, built by a coding agent</span>
          <span class="legend" aria-hidden="true"><span class="lg he"><i></i>Hyper Elements</span><span class="lg re"><i></i>{name}</span></span>
        </div>
        <div class="race">
          {race.map((r) => {
            const max = Math.max(r.he, r.re);
            return (
              <div class="race-row">
                <div class="race-k"><span>{r.k}</span><b>{r.x}</b></div>
                <div class="race-bars">
                  <span class="rb he"><span class="rb-bar"><i style={pct(r.he, max)}></i></span><span class="rb-n"><span class="sr">Hyper Elements </span>{r.fmt(r.he)}</span></span>
                  <span class="rb re"><span class="rb-bar"><i style={pct(r.re, max)}></i></span><span class="rb-n"><span class="sr">{name} </span>{r.fmt(r.re)}</span></span>
                </div>
              </div>
            );
          })}
        </div>
        <p class="board-note">{raceNote} <span class="board-more">The benchmark →</span></p>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h-section">Hyper Elements vs {name} at a glance</h2>
        <p class="sec-sub">What you get with each, side by side, if you’re weighing {article} {name} alternative.</p>
      </div>
      <div class="mx reveal" role="table" aria-label={`Hyper Elements and ${name}, feature by feature`}>
        <div class="mx-row mx-head" role="row">
          <span role="columnheader"><span class="sr">Feature</span></span>
          <span class="mx-col he" role="columnheader"><span class="he-dot" aria-hidden="true"></span>Hyper Elements</span>
          <span class="mx-col" role="columnheader">{name}</span>
        </div>
        {matrix.map((m) => (
          <div class="mx-row" role="row">
            <span class="mx-k" role="rowheader">{m.k}</span>
            <span class="mx-c he" role="cell">
              <span class:list={["mk", m.he]} title={label[m.he]}><span class="sr">{label[m.he]}</span></span>
              {m.heNote && <span class="mx-note">{m.heNote}</span>}
            </span>
            <span class="mx-c" role="cell">
              <span class:list={["mk", m.re]} title={label[m.re]}><span class="sr">{label[m.re]}</span></span>
              {m.reNote && <span class="mx-note">{m.reNote}</span>}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="emu reveal">
        <div class="emu-copy">
          <p class="eyebrow ok">Included free</p>
          <h2 class="emu-title">See it in Outlook, Gmail, Apple Mail and Yahoo Mail before you send</h2>
          <p class="emu-sub">{emuSub}</p>
          <ul class="emu-points">
            {emulatorPoints.map((p) => <li><b>{p.t}</b><span>{p.d}</span></li>)}
          </ul>
          <div class="c-cta left">
            <a class="btn btn-primary btn-sm" href="/email-testing">Try it in your browser <span class="arrow">→</span></a>
            <a class="btn btn-ghost btn-sm" href="/docs/email-client-emulator">Read the docs</a>
          </div>
        </div>
        <div class="emu-side">
          <a class="emu-stage" href="/email-testing" aria-label="Try the email client emulator: classic Outlook, Apple Mail, the Gmail app and more">
            <figure class="emu-win emu-back"><img src="/generated/email-clients/launch-apple-mail.png" width="820" height="985" alt="" loading="lazy" decoding="async" /><figcaption>Apple Mail</figcaption></figure>
            <figure class="emu-win emu-front"><img src="/generated/email-clients/launch-outlook.png" width="820" height="989" alt="" loading="lazy" decoding="async" /><figcaption>Classic Outlook</figcaption></figure>
            <figure class="emu-phone"><img src="/generated/email-clients/launch-gmail-app.png" width="380" height="997" alt="" loading="lazy" decoding="async" /><figcaption>Gmail app</figcaption></figure>
          </a>
          <ul class="emu-clients" aria-label="Email clients and how closely each preview matches the real client">
            {emulatorClients.map((c) => <li><span>{c.name}</span><b>{c.acc}</b></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="chk reveal">
        <div class="chk-copy">
          <p class="eyebrow">Before you send</p>
          <h2 class="chk-title">Every email checked, in code and in CI</h2>
          <p class="chk-sub">Each render lists what classic Outlook, Gmail and the other clients will change, and a mistake stops it with what to write instead.</p>
          <ul class="chk-points">
            {checkPoints.map((p) => <li><b>{p.t}</b><span>{p.d}</span></li>)}
          </ul>
          <p class="brand-re"><span class="mk part" aria-hidden="true"></span><span>{checksNote}</span></p>
          <a class="brand-more" href="/docs/diagnostics">How diagnostics work →</a>
        </div>
        <div class="diag" aria-label="Diagnostics from a real render">
          <div class="diag-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>render(&lt;LaunchEmail /&gt;).diagnostics</div>
          <ul class="diag-list">
            {checks.map((c) => (
              <li class:list={["diag-row", c.severity]}>
                <span class="diag-sev">{c.severity}</span>
                <span class="diag-body"><code>{c.code}</code><span>{c.message}</span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h-section">On brand, in every email</h2>
        <p class="sec-sub">Write your brand once as a theme. The template names no colors or fonts; swap the theme and the same email is someone else's.</p>
      </div>
      <div class="brand-shots reveal">
        {brands.map((b) => (
          <figure class="brand-shot">
            <img src={b.img} width={b.w} height={b.h} alt={`The same announcement email with the ${b.name} theme`} loading="lazy" decoding="async" />
            <figcaption><code>theme=&#123;{b.theme}&#125;</code><span>{b.name}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="brand-row reveal">
        <div class="brand-code">
          <CodeBlock code={brandCode} file="emails/announcement.tsx" />
        </div>
        <div class="brand-side">
          <ul class="brand-parts">
            {brandParts.map((p) => <li><b>{p.t}</b><span>{p.d}</span></li>)}
          </ul>
          <p class="brand-re"><span class="mk part" aria-hidden="true"></span><span>{brandNote}</span></p>
          <a class="brand-more" href="/docs/themes">How themes work →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h-section">The same email in {name} and Hyper Elements</h2>
        <p class="sec-sub">{code.sub}</p>
      </div>
      <div class="ba reveal">
        <div class="ba-side">
          <p class="ba-label"><span class="ba-name"><span class="he-dot" aria-hidden="true"></span>Hyper Elements</span> <a class="ba-stats now" href={bench} title="Median time and output tokens for a coding agent to write a passing email with Hyper Elements"><span>{race[0].fmt(race[0].he)}</span><span>{race[1].fmt(race[1].he)} tokens</span></a></p>
          <CodeBlock code={code.he.code.trim()} lang={code.he.lang} file={code.he.file} />
        </div>
        <div class="ba-side">
          <p class="ba-label"><span class="ba-name re">{name}</span> <a class="ba-stats was" href={bench} title={`Median time and output tokens for a coding agent to write a passing email with ${name}`}><span>{race[0].fmt(race[0].re)}</span><span>{race[1].fmt(race[1].re)} tokens</span></a></p>
          <CodeBlock code={code.other.code.trim()} lang={code.other.lang} file={code.other.file} />
        </div>
      </div>
    </div>
  </section>

  {/* Beyond email: a small strip, since these pages are about email. */}
  <section class="section beyond">
    <div class="wrap">
      <div class="beyond-head reveal">
        <h2>Beyond email</h2>
        <p>Change a template's root and the same content becomes a web page, a PDF or an image.</p>
      </div>
      <div class="outs">
        {outputs.map((o) => (
          <a class="out reveal" href={o.href}>
            <img class="out-img" src={o.img} width={o.w} height={o.h} alt={`${o.ex.title}, a Hyper Elements ${o.kind === "Image" ? "image" : o.kind === "PDF" ? "PDF" : o.kind.toLowerCase()}`} loading="lazy" decoding="async" />
            <span class="out-label"><span class="out-root">&lt;{o.ex.root}&gt;</span><b>{o.kind}</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq-wrap">
      <h2 class="h-section reveal">{faqTitle}</h2>
      <div class="faq reveal">
        {faq.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section final">
    <div class="wrap final-inner reveal">
      <h2 class="h-section">{final.title}</h2>
      <p class="sec-sub">{final.sub}</p>
      <Cmd text={final.cmd} />
      <div class="c-cta">
        {final.ctas.map((c, i) => i === 0 ? <a class="btn btn-primary" href={c.href}>{c.label} <span class="arrow">→</span></a> : <a class="btn btn-ghost" href={c.href}>{c.label}</a>)}
      </div>
      <p class="others">Also compare: {[...others, ...alternatives].map((c, i) => <>{i > 0 && " · "}<a href={c.path}>{c.title}</a></>)}</p>
    </div>
  </section>
</Base>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .he-dot { display: inline-block; width: 8px; height: 8px; border-radius: 999px; background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 18%, transparent); flex: none; }
  .eyebrow { margin: 0; font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-3); }
  .eyebrow.ok { color: var(--ok); }
  .sec-head { text-align: center; margin: 0 auto 48px; max-width: 680px; }
  .sec-head .h-section { margin: 0; }
  .sec-sub { margin: 12px 0 0; color: var(--text-2); font-size: 17px; line-height: 1.55; }
  .c-cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: center; }
  .c-cta.left { justify-content: flex-start; }

  /* Hero, with a glow behind the scoreboard. */
  .c-hero { position: relative; padding: clamp(40px, 6vh, 80px) 0 0; }
  .c-hero::before { content: ""; position: absolute; inset: 160px 0 auto; height: 520px; pointer-events: none; background: radial-gradient(50% 60% at 50% 40%, color-mix(in srgb, var(--ok) 12%, transparent), transparent 70%); }
  .c-hero-inner { position: relative; display: grid; justify-items: center; text-align: center; gap: 14px; grid-template-columns: minmax(0, 1fr); }
  .c-hero .h-page { margin: 0; }
  .c-hero .lede { margin: 0 auto; max-width: 56ch; }
  .c-hero .c-cta { margin-top: 10px; }

  /* The scoreboard. */
  .board { position: relative; display: block; margin-top: 56px; padding: 32px; border: 1px solid var(--line-2); border-radius: 18px; background: linear-gradient(180deg, var(--bg-2), var(--bg-1)); box-shadow: var(--shadow); color: inherit; text-decoration: none; transition: border-color 0.2s; }
  .board:hover, .board:focus-visible { border-color: var(--line-3); }
  .board-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; margin-bottom: 28px; }
  .board-title { font-size: 17px; font-weight: 600; letter-spacing: -0.015em; }
  .legend { display: flex; gap: 18px; font-size: 13px; color: var(--text-2); }
  .lg { display: inline-flex; align-items: center; gap: 8px; }
  .lg i { width: 14px; height: 8px; border-radius: 0 4px 4px 0; }
  .lg.he i { background: var(--ok); }
  .lg.re i { background: var(--text-3); opacity: 0.5; }
  .race { display: grid; gap: 26px; }
  .race-row { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 28px; align-items: center; }
  .race-k { display: grid; gap: 2px; }
  .race-k span { font-size: 14px; color: var(--text-2); }
  .race-k b { font-size: 30px; font-weight: 600; letter-spacing: -0.04em; line-height: 1.1; color: var(--text); }
  .race-bars { display: grid; gap: 8px; min-width: 0; }
  .rb { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .rb-bar { flex: 1 1 auto; display: flex; height: 14px; }
  .rb-bar i { display: block; height: 100%; border-radius: 0 7px 7px 0; }
  .rb.he .rb-bar i { background: linear-gradient(90deg, color-mix(in srgb, var(--ok) 55%, transparent), var(--ok)); }
  .rb.re .rb-bar i { background: var(--text-3); opacity: 0.45; }
  .rb-n { flex: none; width: 52px; font: 500 13px var(--mono); font-variant-numeric: tabular-nums; color: var(--text-2); }
  .rb.he .rb-n { color: var(--text); }
  .board-note { margin: 28px 0 0; padding-top: 18px; border-top: 1px solid var(--line); font-size: 13px; line-height: 1.55; color: var(--text-3); }
  .board-more { color: var(--text-2); white-space: nowrap; }
  .board:hover .board-more { color: var(--text); }

  /* At a glance: a check matrix, the Hyper Elements column lit. */
  .mx { max-width: 920px; margin: 0 auto; border: 1px solid var(--line); border-radius: 16px; background: var(--bg-1); overflow: hidden; }
  .mx-row { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr); border-top: 1px solid var(--line); }
  .mx-row > * { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 13px 22px; }
  .mx-head { border-top: 0; }
  .mx-head > * { padding-top: 18px; padding-bottom: 18px; }
  .mx-col { font-size: 14px; font-weight: 600; color: var(--text-2); }
  .mx-col.he { color: var(--text); }
  .mx-k { font-size: 15px; color: var(--text); }
  .mx-c.he { background: color-mix(in srgb, var(--ok) 6%, transparent); border-left: 1px solid color-mix(in srgb, var(--ok) 22%, transparent); border-right: 1px solid color-mix(in srgb, var(--ok) 22%, transparent); }
  .mx-head .mx-col.he { background: color-mix(in srgb, var(--ok) 10%, transparent); border-left: 1px solid color-mix(in srgb, var(--ok) 22%, transparent); border-right: 1px solid color-mix(in srgb, var(--ok) 22%, transparent); }
  .mx-note { font-size: 13px; color: var(--text-3); }
  .mx-c.he .mx-note { color: var(--text-2); }
  /* The marks: a filled check, a half disc, a dash. */
  .mk { position: relative; flex: none; width: 22px; height: 22px; border-radius: 999px; }
  .mk.yes { background: color-mix(in srgb, var(--ok) 18%, transparent); }
  .mk.yes::after { content: ""; position: absolute; left: 7px; top: 4px; width: 5px; height: 10px; border: solid var(--ok); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .mx-c:not(.he) .mk.yes { background: var(--hover-2); }
  .mx-c:not(.he) .mk.yes::after { border-color: var(--text-2); }
  .mk.part { border: 2px solid var(--text-3); background: linear-gradient(90deg, var(--text-3) 50%, transparent 50%); width: 18px; height: 18px; margin: 2px; }

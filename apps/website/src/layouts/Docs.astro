---
import Base from "./Base.astro";
import { getCollection } from "astro:content";
import { componentGroups, docHref, docsNav, site } from "../lib/site";
import { absoluteLinks } from "../lib/llms";

interface Props {
  title: string;
  description: string;
  /** The page's path after /docs/ ("" for /docs). */
  slug: string;
  headings?: { depth: number; slug: string; text: string }[];
  /** The page as Markdown, for "Copy page". */
  markdown?: string;
  eyebrow?: string;
  /** The browser tab's and search results' title, where it differs from the page's heading. */
  metaTitle?: string;
}
const { title, description, slug, headings = [], markdown, eyebrow, metaTitle } = Astro.props;

const reference = (await getCollection("reference")).filter((e) => e.id !== "overview").sort((a, b) => a.data.order - b.data.order);
const componentNav = componentGroups
  .map((group) => ({
    title: group === "Reference" ? "Reference" : group,
    items: reference.filter((e) => e.data.group === group).map((e) => ({ slug: `components/${e.id}`, label: e.data.title })),
  }))
  .filter((g) => g.items.length);

// Previous and next follow the guide's order, then the components'.
const flat = [...docsNav.flatMap((g) => g.items), { slug: "components", label: "Components" }, ...componentNav.flatMap((g) => g.items)];
const at = flat.findIndex((i) => i.slug === slug);
const prev = at > 0 ? flat[at - 1] : null;
const next = at >= 0 && at < flat.length - 1 ? flat[at + 1] : null;
const group = eyebrow ?? [...docsNav, ...componentNav].find((g) => g.items.some((i) => i.slug === slug))?.title ?? (slug === "components" ? "Components" : "");
// For search engines: what the page is, and where it sits in the docs.
const url = new URL(docHref(slug), site.url).href;
// Every crumb is a page: Docs, the component index for a component's page, then the page itself.
const crumbs = [
  { name: "Docs", url: new URL("/docs", site.url).href },
  ...(slug.startsWith("components/") ? [{ name: "Components", url: new URL("/docs/components", site.url).href }] : []),
  ...(slug ? [{ name: title, url }] : []),
];
const jsonLd = [
  { "@context": "https://schema.org", "@type": "TechArticle", headline: title, description, url, inLanguage: "en", isPartOf: { "@type": "WebSite", name: site.name, url: site.url } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: crumbs.map((c, n) => ({ "@type": "ListItem", position: n + 1, name: c.name, item: c.url })) },
];
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const isCurrent = (s: string) => s === slug;
---
<Base title={metaTitle ?? title} description={description} ogType="article" jsonLd={jsonLd}>
  <div class="docs wrap">
    <aside class="docs-side" aria-label="Docs">
      <details class="side-mobile">
        <summary>Menu <span class="muted">· {title}</span></summary>
      </details>
      <nav class="side-nav">
        {docsNav.map((g) => (
          <div class="side-group">
            <p class="side-title">{g.title}</p>
            <ul>
              {g.items.map((i) => (
                <li><a href={docHref(i.slug)} aria-current={isCurrent(i.slug) ? "page" : undefined}>{i.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <div class="side-group">
          <p class="side-title"><a href="/docs/components" aria-current={isCurrent("components") ? "page" : undefined}>Components</a></p>
          {componentNav.map((g) => (
            <details class="side-sub" open={g.items.some((i) => isCurrent(i.slug)) || undefined}>
              <summary>{g.title}</summary>
              <ul>
                {g.items.map((i) => (
                  <li><a href={docHref(i.slug)} aria-current={isCurrent(i.slug) ? "page" : undefined}>{i.label}</a></li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </nav>
    </aside>

    <article class="docs-main">
      <header class="docs-head">
        {group && <p class="eyebrow">{group}</p>}
        <div class="docs-title-row">
          <h1>{title}</h1>
          {markdown && (
            <button class="btn btn-ghost btn-sm" type="button" data-copy-page title="Copy this page as Markdown, for an AI agent">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
              Copy page
            </button>
          )}
        </div>
        <p class="docs-desc">{description}</p>
      </header>
      <div class="prose"><slot /></div>
      <nav class="pager" aria-label="Previous and next">
        {prev ? <a href={docHref(prev.slug)}><span>Previous</span>{prev.label}</a> : <span></span>}
        {next ? <a class="next" href={docHref(next.slug)}><span>Next</span>{next.label}</a> : <span></span>}
      </nav>
    </article>

    <aside class="docs-toc" aria-label="On this page">
      {toc.length > 0 && (
        <>
          <p class="side-title">On this page</p>
          <ul>
            {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ul>
        </>
      )}
      <div class="toc-extra">
        <a href="/llms.txt">llms.txt</a>
        <a href="https://github.com/hyper-elements/hyper-elements">Edit on GitHub</a>
      </div>
    </aside>
  </div>
  <dialog class="lightbox" aria-label="Image at full size">
    <div class="lightbox-bar">
      <p class="lightbox-caption"></p>
      <div class="lightbox-actions">
        <button type="button" data-step="-1" aria-label="Previous image">←</button>
        <button type="button" data-step="1" aria-label="Next image">→</button>
        <a class="lightbox-open" target="_blank" rel="noopener">Open in a new tab</a>
        <button type="button" data-close aria-label="Close" autofocus>✕</button>
      </div>
    </div>
    <div class="lightbox-body"><img alt="" /></div>
  </dialog>
  {markdown && <script type="text/markdown" id="page-markdown" set:html={absoluteLinks(`# ${title}\n\n${description}\n\n${markdown.replaceAll("</script", "<\\/script")}`)}></script>}
</Base>

<script>
  // On phones, the sidebar opens from its summary.
  const mobile = document.querySelector<HTMLDetailsElement>(".side-mobile");
  const side = document.querySelector<HTMLElement>(".docs-side");
  mobile?.addEventListener("toggle", () => side?.classList.toggle("open", mobile.open));

  // A gallery image opens at full size in a lightbox, with the gallery's other images a step away.
  const box = document.querySelector<HTMLDialogElement>(".lightbox");
  if (box) {
    const img = box.querySelector("img")!;
    const caption = box.querySelector<HTMLElement>(".lightbox-caption")!;
    const open = box.querySelector<HTMLAnchorElement>(".lightbox-open")!;
    const steps = box.querySelectorAll<HTMLButtonElement>("[data-step]");
    let links: HTMLAnchorElement[] = [];
    let at = 0;
    const show = (i: number) => {
      at = (i + links.length) % links.length;
      const link = links[at];
      const thumb = link.querySelector("img");
      img.src = link.href;
      img.alt = thumb?.alt ?? "";
      // The email (the label before the gallery) and the client (the figure's caption).
      const email = link.closest(".client-gallery")?.previousElementSibling?.textContent?.trim();
      const client = link.closest("figure")?.querySelector("figcaption")?.textContent?.trim();
      caption.textContent = [email, client].filter(Boolean).join(" · ") || thumb?.alt || "";
      open.href = link.href;
      box.querySelector(".lightbox-body")!.scrollTop = 0;
    };
    document.addEventListener("click", (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>(".prose .client-gallery a");
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      links = [...link.closest(".client-gallery")!.querySelectorAll<HTMLAnchorElement>("a")];
      steps.forEach((b) => (b.hidden = links.length < 2));
      show(links.indexOf(link));
      box.showModal();
    });
    steps.forEach((b) => b.addEventListener("click", () => show(at + Number(b.dataset.step))));
    box.querySelector("[data-close]")!.addEventListener("click", () => box.close());
    // A click outside the picture closes it.
    box.addEventListener("click", (event) => {
      if (event.target === box || (event.target as Element).classList.contains("lightbox-body")) box.close();
    });
    box.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") show(at + (event.key === "ArrowLeft" ? -1 : 1));
    });
    box.addEventListener("close", () => img.removeAttribute("src"));
  }
</script>

<style>
  .docs { display: grid; grid-template-columns: 240px minmax(0, 1fr) 210px; gap: 48px; max-width: 1360px; padding-top: 40px; padding-bottom: 40px; }
  .docs-side { position: sticky; top: calc(var(--header) + 24px); align-self: start; max-height: calc(100vh - var(--header) - 48px); overflow: auto; padding-right: 8px; scrollbar-width: thin; }
  .side-mobile { display: none; }
  .side-group { margin-bottom: 22px; }
  .side-title { margin: 0 0 8px; font: 500 11.5px var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-3); }
  .side-title a { color: inherit; text-decoration: none; }
  .side-title a:hover, .side-title a[aria-current] { color: var(--text); }
  .side-nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .side-nav li a { display: block; padding: 5px 10px; border-radius: 7px; color: var(--text-2); text-decoration: none; font-size: 14px; border-left: 1px solid transparent; }
  .side-nav li a:hover { color: var(--text); background: rgba(255, 255, 255, 0.04); }
  .side-nav li a[aria-current] { color: var(--text); background: var(--hover-2); box-shadow: inset 2px 0 0 var(--text); }
  .side-sub summary { cursor: pointer; list-style: none; font-size: 14px; color: var(--text-2); padding: 5px 10px; border-radius: 7px; display: flex; justify-content: space-between; }
  .side-sub summary::-webkit-details-marker { display: none; }
  .side-sub summary::after { content: "+"; color: var(--text-3); }
  .side-sub[open] summary::after { content: "–"; }
  .side-sub summary:hover { color: var(--text); background: rgba(255, 255, 255, 0.04); }
  .side-sub ul { padding-left: 10px !important; margin: 2px 0 6px !important; border-left: 1px solid var(--line); margin-left: 10px !important; }

  .docs-main { min-width: 0; max-width: 780px; }
  .docs-head { padding-bottom: 28px; margin-bottom: 32px; border-bottom: 1px solid var(--line); }
  .docs-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .docs-head h1 { margin: 0; font-size: clamp(32px, 4vw, 44px); letter-spacing: -0.04em; line-height: 1.08; font-weight: 600; }
  .docs-desc { margin: 14px 0 0; color: var(--text-2); font-size: 18px; line-height: 1.55; }
  .docs-title-row .btn { flex: none; margin-top: 6px; }

  .docs-toc { position: sticky; top: calc(var(--header) + 24px); align-self: start; font-size: 13px; max-height: calc(100vh - var(--header) - 48px); overflow: auto; }
  .docs-toc ul { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 6px; border-left: 1px solid var(--line); }
  .docs-toc li a { display: block; padding-left: 12px; color: var(--text-3); text-decoration: none; line-height: 1.4; }
  .docs-toc li.d3 a { padding-left: 24px; }
  .docs-toc li a:hover { color: var(--text); }
  .toc-extra { display: grid; gap: 8px; padding-top: 16px; border-top: 1px solid var(--line); }
  .toc-extra a { color: var(--text-3); text-decoration: none; }
  .toc-extra a:hover { color: var(--text); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line); }
  .pager a { display: grid; gap: 2px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; font-weight: 500; transition: border-color 0.15s; }
  .pager a:hover { border-color: var(--line-3); }
  .pager a span { font: 400 12px var(--mono); color: var(--text-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .pager .next { text-align: right; }

  /* Prose */
  .prose { font-size: 16px; line-height: 1.75; color: var(--prose); }
  .prose :global(h2) { font-size: 26px; letter-spacing: -0.03em; line-height: 1.2; color: var(--text); margin: 56px 0 16px; font-weight: 600; }
  .prose :global(h3) { font-size: 19px; letter-spacing: -0.02em; color: var(--text); margin: 36px 0 12px; font-weight: 600; }
  .prose :global(h4) { font-size: 16px; color: var(--text); margin: 28px 0 8px; }
  .prose :global(> :first-child) { margin-top: 0; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 18px; }
  .prose :global(li) { margin: 6px 0; }
  .prose :global(li::marker) { color: var(--text-3); }
  .prose :global(a) { color: var(--text); text-decoration: underline; text-decoration-color: var(--line-3); text-underline-offset: 3px; }
  .prose :global(a:hover) { text-decoration-color: var(--text); }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose > :global(pre) { margin: 0 0 22px; border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px !important; font: 400 13.5px/1.7 var(--mono); overflow: auto; background: #0e0e0e !important; }
  .prose :global(blockquote) { margin: 0 0 22px; padding: 14px 18px; border: 1px solid var(--line); border-left: 3px solid var(--line-3); border-radius: 10px; background: rgba(239, 70, 56, 0.05); color: var(--text-2); }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 22px; font-size: 14.5px; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(th) { color: var(--text); font-weight: 600; font-size: 13px; border-bottom-color: var(--line-2); }
  /* Code in a table stays on one line, so a tag like <Document> or a path isn't split; a wide table scrolls. */
  .prose :global(td code), .prose :global(th code) { white-space: nowrap; }
  .prose :global(hr) { border: 0; height: 1px; background: var(--line); margin: 40px 0; }
  .prose :global(h2 a), .prose :global(h3 a) { text-decoration: none; }
  /* Email client emulator: an email's previews side by side, one per client. */
  /* Three desktop previews (820px) and the Gmail app's (380px), at one scale. */
  .prose :global(.client-gallery) { display: grid; grid-template-columns: repeat(3, minmax(0, 820fr)) minmax(0, 380fr); gap: 12px; align-items: start; margin: 0 0 28px; }
  .prose :global(.client-gallery figure) { margin: 0; min-width: 0; }
  .prose :global(.client-gallery img) { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 8px; }
  .prose :global(.client-gallery figcaption) { margin-top: 6px; font-size: 13px; line-height: 1.4; color: var(--text-3); }
  @media (max-width: 760px) { .prose :global(.client-gallery) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .prose :global(.client-gallery) { grid-template-columns: minmax(0, 1fr); } .prose :global(.client-gallery img[width="380"]) { max-width: 380px; } }
  .prose :global(.client-gallery a) { cursor: zoom-in; }
  .lightbox { width: min(980px, calc(100vw - 32px)); max-width: none; height: calc(100vh - 48px); max-height: none; margin: auto; padding: 0; border: 1px solid var(--line-2); border-radius: var(--radius); background: var(--bg-1); color: var(--text); box-shadow: var(--shadow); overflow: hidden; }
  .lightbox[open] { display: flex; flex-direction: column; }
  .lightbox::backdrop { background: rgba(0, 0, 0, 0.72); }
  .lightbox-bar { display: flex; align-items: center; gap: 12px; padding: 10px 12px 10px 18px; border-bottom: 1px solid var(--line); }
  .lightbox-caption { margin: 0; flex: 1; min-width: 0; font-size: 14px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lightbox-actions { display: flex; align-items: center; gap: 6px; }
  .lightbox-actions button, .lightbox-open { height: 32px; min-width: 32px; padding: 0 10px; border: 1px solid var(--line-2); border-radius: var(--radius-sm); background: var(--bg-2); color: var(--text); font: 500 13px var(--sans); text-decoration: none; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  .lightbox-actions button:hover, .lightbox-open:hover { background: var(--hover-2); }
  .lightbox-actions button:focus-visible, .lightbox-open:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
  .lightbox-actions [hidden] { display: none; }
  .lightbox-body { flex: 1; overflow: auto; padding: 20px; display: flex; justify-content: center; align-items: flex-start; cursor: zoom-out; }
  .lightbox-body img { display: block; max-width: 100%; height: auto; border-radius: 6px; cursor: default; }
  @media (max-width: 560px) { .lightbox { width: 100vw; height: 100dvh; border-radius: 0; border: 0; } .lightbox-open { display: none; } .lightbox-body { padding: 12px; } }

  @media (max-width: 1180px) {
    .docs { grid-template-columns: 220px minmax(0, 1fr); }
    .docs-toc { display: none; }
  }
  @media (max-width: 860px) {
    .docs { grid-template-columns: minmax(0, 1fr); gap: 0; padding-top: 0; }
    .docs-side { position: static; max-height: none; overflow: visible; margin: 0 -16px 24px; padding: 0 16px; border-bottom: 1px solid var(--line); }
    .side-mobile { display: block; }
    .side-mobile summary { cursor: pointer; padding: 14px 0; font-weight: 500; font-size: 14.5px; list-style: none; }
    .side-mobile summary::-webkit-details-marker { display: none; }
    .side-nav { display: none; padding-bottom: 16px; }
    .docs-side.open .side-nav { display: block; }
    .docs-title-row { flex-direction: column; }
  }
</style>
